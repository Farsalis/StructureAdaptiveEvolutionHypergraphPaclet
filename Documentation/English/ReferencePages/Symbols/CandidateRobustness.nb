Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"StructureAdaptiveEvolution", "[", 
    RowBox[{
     RowBox[{"\"\<Rule\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], "}"}]}]}], ",", 
     RowBox[{"\"\<InitialState\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"\"\<Rounds\>\"", "\[Rule]", "1"}], ",", 
     RowBox[{"\"\<MutationBudget\>\"", "\[Rule]", "4"}], ",", 
     RowBox[{"\"\<EvolutionLimits\>\"", "\[Rule]", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "4"}], ",", 
        RowBox[{"\"\<MaxEvents\>\"", "\[Rule]", "300"}]}], "]"}]}], ",", 
     RowBox[{"\"\<InitialStateDiagnostics\>\"", "\[Rule]", "None"}], ",", 
     RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", "1"}]}], "]"}]}], ";", 
  RowBox[{"Length", "[", 
   RowBox[{"result", "[", "\"\<SolutionParetoFront\>\"", "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->517214504,ExpressionUUID->"92b0a9eb-ca9e-e748-980a-410a7add0cc9"],

Cell[BoxData["1"], "Output",
 CellLabel->"Out[1]=",
 CellID->433294257,ExpressionUUID->"dc554321-d646-b142-a839-4e867d9d1c53"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"robustness", "=", 
   RowBox[{"CandidateRobustness", "[", 
    RowBox[{"result", ",", 
     RowBox[{
      RowBox[{"result", "[", "\"\<SolutionParetoFront\>\"", "]"}], "\[LeftDoubleBracket]", 
      RowBox[{"1", ",", "\"\<CandidateID\>\""}], "\[RightDoubleBracket]"}], ",", 
     RowBox[{"\"\<EnsembleSize\>\"", "\[Rule]", "3"}]}], "]"}]}], ";", 
  RowBox[{"Keys", "[", "robustness", "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->149270501,ExpressionUUID->"50b43298-a7d4-7248-af94-21909b93a52f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"CandidateID\"\>", ",", "\<\"Rule\"\>", 
   ",", "\<\"InitialState\"\>", ",", "\<\"BaseStatus\"\>", 
   ",", "\<\"BaseEvolutionLimits\"\>", ",", "\<\"StateEquivalence\"\>", 
   ",", "\<\"CapSensitivity\"\>", ",", "\<\"InitialStateCorpus\"\>", 
   ",", "\<\"RewriteSemantics\"\>", ",", "\<\"CapSensitiveQ\"\>", 
   ",", "\<\"SemanticsSensitiveQ\"\>", ",", "\<\"Summary\"\>"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->990032357,ExpressionUUID->"d70a9906-d46d-1847-9ef1-dbc65fde1238"]
}, Open  ]],

