Notebook[{

Cell[CellGroupData[{
Cell["CandidateRobustness", "ObjectName",
 CellID->239722310,ExpressionUUID->"aa7122d1-73c3-9542-9773-e236ba4220e2"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5aeb0a3d-36d7-9b47-9400-ed3f9807c4e2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CandidateRobustness",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
CandidateRobustness"], 
   RowBox[{"[", 
    RowBox[{"result", ",", " ", "candidateID"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"3233c2b8-f0f6-2742-9182-90029a10f51f"],
 " \[LineSeparator]",
 "tests how robust the outcome of a candidate is to the evolution limits, the \
initial state and the rewrite semantics."
}], "Usage",
 CellID->318555768,ExpressionUUID->"61274bc8-8e04-ef41-9269-62fd3607b0b3"],

Cell["\<\
Cap sensitivity: every numeric evolution limit is scaled by the factors in \
\"CapFactors\" (default {2, 4}) and status changes are reported, with \
\"CapSensitiveQ\". Initial states: \"InitialStates\" -> Automatic evaluates a \
seeded ensemble of \"EnsembleSize\" (8) states with the seed's signature (or \
give a list of states), reporting the termination rate and the state-count \
distribution. Rewrite semantics: EdgeToken and VertexDeletion are compared.\
\>", "Notes",
 CellID->299311416,ExpressionUUID->"7838a8da-d988-9741-bb20-7302e10ed6ee"],

Cell["\<\
Other options: \"RandomSeed\", \"RewriteSemantics\" (True to compare \
semantics) and \"ConfidenceLevel\".\
\>", "Notes",
 CellID->373293266,ExpressionUUID->"f0b70fbc-c932-274e-b40f-dd82aa80377a"]
}, Open  ]],

