Notebook[{

Cell[CellGroupData[{
Cell["DelayedTerminationStep", "ObjectName",
 CellID->12422595,ExpressionUUID->"fa108816-956b-f24c-b25a-4bc3dcafe055"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"293363f1-a5fe-f54f-9f32-70f442362db3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DelayedTerminationStep",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
DelayedTerminationStep"], 
   RowBox[{"[", 
    RowBox[{"rule", ",", " ", "evolveFunction"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"3346bbf0-63d0-3546-87cc-a230a5a55a90"],
 " \[LineSeparator]",
 "applies \
[DelayedTerminationMutation](paclet:SamuelFrerichs/StructureAdaptiveEvolution/\
ref/DelayedTerminationMutation) to ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "93a8e4db-34fa-2f44-8cd7-e7c06ddfa716"],
 " and accepts the mutant when it still halts but lives longer."
}], "Usage",
 CellID->893915715,ExpressionUUID->"bdd63716-3a21-9143-adf0-2b7b4337c951"],

Cell[TextData[{
 StyleBox["evolveFunction",
  FontSlant->Italic],
 Cell[BoxData[
  TemplateBox[{
   "*r*] must give the generations of a multiway evolution of *r*. The mutant \
is accepted when it halts within the cap, its breadth-first lifetime \
increases and its state count does not decrease.\n\nThis standalone \
hill-climbing step predates the central search; [StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "99487865-6595-2041-bea0-8b7c947bbef8"],
 " uses the mutation operators directly and evaluates candidates with one \
shared evaluator. The step gives an Association with \"AcceptedQ\", \"Rule\" \
(the mutant if accepted, else the input), \"CandidateRule\", \"OldFitness\" \
and \"NewFitness\"."
}], "Notes",
 CellID->546992199,ExpressionUUID->"d23720a7-f325-8b40-9888-dd02592a0484"]
}, Open  ]],

