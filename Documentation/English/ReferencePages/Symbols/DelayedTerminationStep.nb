Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"evolveGenerations", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CanonicalMultiwayEvolution", "[", 
      RowBox[{"#1", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "}"}], ",", 
       RowBox[{"Association", "[", 
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "3"}], "]"}]}], "]"}], 
     "[", "\"\<Generations\>\"", "]"}], "&"}]}], ";", 
  RowBox[{"Length", "/@", 
   RowBox[{"evolveGenerations", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->583457495,ExpressionUUID->"84618ee2-f39e-454a-8184-81111c6d5953"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->161848899,ExpressionUUID->"2f2ed586-32e8-ec46-b13a-fb50571a2ad4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BlockRandom", "[", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "2", "]"}], ";", 
   RowBox[{"DelayedTerminationStep", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], "}"}]}], ",", "evolveGenerations"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->52231627,ExpressionUUID->"de4c2b4a-5154-654b-a6d0-df35094bc940"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"AcceptedQ\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"Rule\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], "}"}]}]}], ",", 
   RowBox[{"\<\"CandidateRule\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], "}"}]}]}], ",", 
   RowBox[{"\<\"OldFitness\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"MultiwayLifetime\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"MultiwayStateCount\"\>", "\[Rule]", "2"}], ",", 
      RowBox[{"\<\"HGMaxVerticesCount\"\>", "\[Rule]", "3"}], ",", 
      RowBox[{"\<\"HGMaxEdgesCount\"\>", "\[Rule]", "2"}], ",", 
      RowBox[{"\<\"HaltedWithinCapQ\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"Runtime\"\>", "\[Rule]", "0.065506`"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"NewFitness\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"MultiwayLifetime\"\>", "\[Rule]", "0"}], ",", 
      RowBox[{"\<\"MultiwayStateCount\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"HGMaxVerticesCount\"\>", "\[Rule]", "3"}], ",", 
      RowBox[{"\<\"HGMaxEdgesCount\"\>", "\[Rule]", "2"}], ",", 
      RowBox[{"\<\"HaltedWithinCapQ\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"Runtime\"\>", "\[Rule]", "0.035209`"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->525352892,ExpressionUUID->"2c7df14d-4a39-194f-bc51-36a978acd4dd"]
}, Open  ]]
}, Open  ]],

