Cell["MWHypergraphLifetime", "ObjectName",
 CellID->137665533,ExpressionUUID->"fb749089-16af-944b-907d-98cff60c247e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b65f64bb-27a3-0a42-b7ab-61af3505a564"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MWHypergraphLifetime",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
MWHypergraphLifetime"], 
   RowBox[{"[", "g", "]"}]}]], "InlineFormula",ExpressionUUID->
  "b97ce8a3-4375-1e4f-99a8-fef32f479ad0"],
 " \[LineSeparator]",
 "gives the largest distance from the initial state to a terminal state in \
the multiway states graph ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "3f6dc33d-efd8-534b-856e-989a9b52e25a"],
 "."
}], "Usage",
 CellID->59495367,ExpressionUUID->"355e4ad0-42ee-7041-bacd-a37ad0f0cbe3"],

Cell[TextData[{
 "Distances are shortest-path distances, so this is not the longest \
derivation; use ",
 Cell[BoxData[
  TemplateBox[{
   "MultiwayLongestDerivation", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
MultiwayLongestDerivation", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/MultiwayLongestDerivation.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "ca78b131-7e8d-d64d-bd2e-08b90f138eea"],
 " for that."
}], "Notes",
 CellID->62397402,ExpressionUUID->"d3149f8a-da63-dd4e-b7ca-06e5c70ee30b"]
}, Open  ]],

