 CellLabel->"Out[1]=",
 CellID->862355813,ExpressionUUID->"297379c2-8139-6149-8aa5-0122dc863fb6"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ExperimentStoreLoad", "[", 
   RowBox[{"store", ",", 
    RowBox[{"result", "[", "\"\<RunID\>\"", "]"}]}], "]"}], "===", 
  "result"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->258719881,ExpressionUUID->"bcb3e0e4-647f-8044-82d7-9495303c0530"],

