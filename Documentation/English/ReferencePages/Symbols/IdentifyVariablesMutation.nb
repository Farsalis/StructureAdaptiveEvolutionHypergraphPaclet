Cell[CellGroupData[{
Cell["IdentifyVariablesMutation", "ObjectName",
 CellID->858863647,ExpressionUUID->"35509efe-0ebe-6040-9f58-64ed705618c3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"78cb8e74-8aae-8849-86e8-353419afeed7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IdentifyVariablesMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
IdentifyVariablesMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "3e64781b-9e3b-4848-a471-b75e048bbc21"],
 " \[LineSeparator]",
 "merges two distinct variables of ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "cc6cb82b-55f1-f44e-907e-0749f9d1a64b"],
 " into one."
}], "Usage",
 CellID->695669351,ExpressionUUID->"2abb37cf-82b9-2043-8db5-f09b2ca33a7c"],

Cell["Edge counts and arities are unchanged.", "Notes",
 CellID->570471962,ExpressionUUID->"69d573ce-3c2c-b54d-821f-80c43e1b8a58"],

Cell[TextData[{
 "Mutations are random. The result is a rule, an Association with the keys \
\"Rule\" and \"Details\", or a Failure when no valid, canonically different \
mutant exists. Within ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "cae41350-8b9c-cd4a-a53a-a8782351dda8"],
 " every operator that runs is recorded in the candidate's provenance."
}], "Notes",
 CellID->365208922,ExpressionUUID->"b814bf68-14d1-f340-bfa7-d0d36f50f5f4"]
}, Open  ]],

