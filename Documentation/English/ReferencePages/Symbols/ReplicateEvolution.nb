Notebook[{

Cell[CellGroupData[{
Cell["ReplicateEvolution", "ObjectName",
 CellID->771549386,ExpressionUUID->"ac79f9d2-d7f8-dd4d-ac12-ce40b67946db"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0f9db800-c5fa-3148-9295-17959bf288c2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReplicateEvolution",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
ReplicateEvolution"], 
   RowBox[{"[", 
    RowBox[{"opts", ",", " ", "seeds"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"266acc9e-c986-6548-89f6-f72f5a0c1db4"],
 " \[LineSeparator]",
 "runs `StructureAdaptiveEvolution[opts]` once per random seed in ",
 Cell[BoxData[
  StyleBox["seeds", "TI"]], "InlineFormula",ExpressionUUID->
  "96e0e224-d824-494a-9d1d-6086f5dc12fd"],
 " and summarizes the runs."
}], "Usage",
 CellID->557572052,ExpressionUUID->"1e068b0e-2ee0-4649-89ab-93e8a8bc7833"],

Cell["\<\
Failed runs and runs without a verified solution are kept. The result gives \
\"Runs\" (per run: run ID, seed, verified solution count, best values over \
verified solutions, evaluations, fresh evaluations, wall time, failure), \
\"SuccessFraction\" (runs with at least one verified solution, with its \
Wilson interval), \"Distributions\" (per metric, the per-run best values and \
their quantiles) and \"Results\" (the full results).\
\>", "Notes",
 CellID->335074035,ExpressionUUID->"e9e9b768-7e7d-a24b-b2e2-9ba7d5a5844c"],

Cell["\<\
Options: \"Metrics\" (default MultiwayStateCount, MultiwayTransitionCount, \
MultiwayLongestDerivation, HGMaxVerticesCount) and \"ConfidenceLevel\" (0.95).\
\>", "Notes",
 CellID->776720872,ExpressionUUID->"c6acc7c6-5649-594c-a3a6-dd3d6ad06e4d"]
}, Open  ]],

