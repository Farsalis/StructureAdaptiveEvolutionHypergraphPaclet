Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"replication", "=", 
   RowBox[{"ReplicateEvolution", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<Rule\>\"", "\[Rule]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}], "}"}]}]}], ",", 
       RowBox[{"\"\<InitialState\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"\"\<Rounds\>\"", "\[Rule]", "1"}], ",", 
       RowBox[{"\"\<MutationBudget\>\"", "\[Rule]", "2"}], ",", 
       RowBox[{"\"\<EvolutionLimits\>\"", "\[Rule]", 
        RowBox[{"Association", "[", 
         RowBox[{
          RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "3"}], ",", 
          RowBox[{"\"\<MaxEvents\>\"", "\[Rule]", "200"}]}], "]"}]}], ",", 
       RowBox[{"\"\<InitialStateDiagnostics\>\"", "\[Rule]", "None"}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"replication", "[", "\"\<SuccessFraction\>\"", "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->996938336,ExpressionUUID->"dc2ad99b-e742-6f4e-8e27-8b95287fe8a0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Fraction\"\>", "\[Rule]", "1.`"}], ",", 
   RowBox[{"\<\"Successes\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"Trials\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"WilsonInterval\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.34238022750665315`", ",", "1.`"}], "}"}]}], ",", 
   RowBox[{"\<\"ConfidenceLevel\"\>", "\[Rule]", "0.95`"}], ",", 
   RowBox[{"\<\"Definition\"\>", 
    "\[Rule]", "\<\"Runs with at least one verified solution (Halted, at \
least one transition, every constraint satisfied); failed runs count as runs \
without a solution.\"\>"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->549621149,ExpressionUUID->"5062d6ec-ba72-1b4c-80c9-2afc0393222c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"replication", "[", "\"\<Runs\>\"", "]"}], "\[LeftDoubleBracket]", 
  RowBox[{"All", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<Seed\>\"", ",", "\"\<SolutionCount\>\""}], "}"}]}], 
  "\[RightDoubleBracket]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->98189397,ExpressionUUID->"14f51c15-a2a1-7642-8bf1-78674f336feb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Seed\"\>", "\[Rule]", "1"}], ",", 
     RowBox[{"\<\"SolutionCount\"\>", "\[Rule]", "2"}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Seed\"\>", "\[Rule]", "2"}], ",", 
     RowBox[{"\<\"SolutionCount\"\>", "\[Rule]", "2"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->473916610,ExpressionUUID->"627fdb19-35e8-6e43-b028-2dd743159add"]
}, Open  ]]
}, Open  ]],

