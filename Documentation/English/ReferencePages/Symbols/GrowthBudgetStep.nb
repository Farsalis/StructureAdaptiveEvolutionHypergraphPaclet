Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"evolveStates", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CanonicalMultiwayEvolution", "[", 
      RowBox[{"#1", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "}"}], ",", 
       RowBox[{"Association", "[", 
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "3"}], "]"}]}], "]"}], 
     "[", "\"\<States\>\"", "]"}], "&"}]}], ";", 
  RowBox[{"Length", "[", 
   RowBox[{"evolveStates", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->81613853,ExpressionUUID->"3095ac00-8f2c-684c-80e0-3449fa990710"],

Cell[BoxData["4"], "Output",
 CellLabel->"Out[1]=",
 CellID->941590101,ExpressionUUID->"84e836c9-a4ed-934a-8b36-34db996c249e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BlockRandom", "[", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "2", "]"}], ";", 
   RowBox[{"GrowthBudgetStep", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], ",", "evolveStates", ",", 
     
     RowBox[{"{", 
      RowBox[{"0.`", ",", "2.`"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->682408861,ExpressionUUID->"a945fdad-0170-764c-9f8c-e86a2d569f11"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"AcceptedQ\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Rule\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "v4388"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "v4388"}], "}"}]}], "}"}]}]}], ",", 
   RowBox[{"\<\"CandidateRule\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "v4388"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "v4388"}], "}"}]}], "}"}]}]}], ",", 
   RowBox[{"\<\"OldFitness\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"HGMaxVerticesCount\"\>", "\[Rule]", "6"}], ",", 
      RowBox[{"\<\"HGMaxEdgesCount\"\>", "\[Rule]", "5"}], ",", 
      RowBox[{"\<\"HGMaxEdgeToVertexRatio\"\>", "\[Rule]", 
       "0.8333333333333334`"}], ",", 
      RowBox[{"\<\"FinalVertexCount\"\>", "\[Rule]", "6"}], ",", 
      RowBox[{"\<\"FinalEdgeCount\"\>", "\[Rule]", "5"}], ",", 
      RowBox[{"\<\"FinalDensity\"\>", "\[Rule]", "0.23809523809523808`"}], ",", 
      RowBox[{"\<\"Runtime\"\>", "\[Rule]", "0.17861`"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"NewFitness\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"HGMaxVerticesCount\"\>", "\[Rule]", "9"}], ",", 
      RowBox[{"\<\"HGMaxEdgesCount\"\>", "\[Rule]", "11"}], ",", 
      RowBox[{"\<\"HGMaxEdgeToVertexRatio\"\>", "\[Rule]", 
       "1.2222222222222223`"}], ",", 
      RowBox[{"\<\"FinalVertexCount\"\>", "\[Rule]", "9"}], ",", 
      RowBox[{"\<\"FinalEdgeCount\"\>", "\[Rule]", "11"}], ",", 
      RowBox[{"\<\"FinalDensity\"\>", "\[Rule]", "0.24444444444444444`"}], ",", 
      RowBox[{"\<\"Runtime\"\>", "\[Rule]", "0.5916475`"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->605989507,ExpressionUUID->"f9071752-0a1f-144e-b155-97b925ee6400"]
}, Open  ]]
}, Open  ]],

