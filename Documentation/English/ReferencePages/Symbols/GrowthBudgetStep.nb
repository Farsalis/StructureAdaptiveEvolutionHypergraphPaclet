Notebook[{

Cell[CellGroupData[{
Cell["GrowthBudgetStep", "ObjectName",
 CellID->273091840,ExpressionUUID->"8e17f3ef-9afa-f446-95bf-581150520d34"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"27f915c4-2638-1741-83cf-c9e7fc21ff67"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GrowthBudgetStep",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/GrowthBudgetStep"], 
   RowBox[{"[", 
    RowBox[{"rule", ",", " ", "evolveFunction", ",", " ", "ratioRange"}], 
    "]"}]}]], "InlineFormula",ExpressionUUID->
  "9fc0df1f-d3c4-b14b-9ea5-998010a172b0"],
 " \[LineSeparator]",
 "applies \
[GrowthBudgetMutation](paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
GrowthBudgetMutation) to ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "a2668dfb-e385-8642-af97-a08b53fa4743"],
 ", evolves both rules with ",
 Cell[BoxData[
  StyleBox["evolveFunction", "TI"]], "InlineFormula",ExpressionUUID->
  "1d953eb5-a309-d84a-88e2-9cdd8495c93d"],
 " and accepts the mutant when the growth-budget test passes."
}], "Usage",
 CellID->816427868,ExpressionUUID->"78ae74ee-de92-ed46-b003-6635ecbccf37"],

Cell[TextData[{
 StyleBox["evolveFunction",
  FontSlant->Italic],
 Cell[BoxData[
  TemplateBox[{
   "*r*] must give a flat list of hypergraph states of an evolution of *r*. \
The mutant is accepted when its maximum edge-to-vertex ratio lies in \
*ratioRange* (default {0., Infinity}), its maximum vertex and edge counts do \
not decrease, and at least one of them increases.\n\nThis standalone \
hill-climbing step predates the central search; [StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "1ef268fb-d702-ce44-adaa-23d30d54e586"],
 " uses the mutation operators directly and evaluates candidates with one \
shared evaluator. The step gives an Association with \"AcceptedQ\", \"Rule\" \
(the mutant if accepted, else the input), \"CandidateRule\", \"OldFitness\" \
and \"NewFitness\"."
}], "Notes",
 CellID->71952056,ExpressionUUID->"dd5dd8c7-c89f-b546-9ef0-9daec09201d4"]
}, Open  ]],

