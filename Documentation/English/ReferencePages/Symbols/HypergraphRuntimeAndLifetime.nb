Notebook[{

Cell[CellGroupData[{
Cell["HypergraphRuntimeAndLifetime", "ObjectName",
 CellID->245669637,ExpressionUUID->"7afcae94-f663-a146-b38b-76060b8dfc7e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"30256267-e250-894f-8e3d-6ef9366ae6f4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HypergraphRuntimeAndLifetime",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
HypergraphRuntimeAndLifetime"], 
   RowBox[{"[", 
    RowBox[{"rule", ",", " ", "state", ",", " ", "maxGenerations"}], "]"}]}]],
   "InlineFormula",ExpressionUUID->"443ec533-e000-2e44-ab5f-6eadb6e37650"],
 " \[LineSeparator]",
 "evolves ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "fc48a493-4498-a148-b2a1-96d8a9c87b82"],
 " from ",
 Cell[BoxData[
  StyleBox["state", "TI"]], "InlineFormula",ExpressionUUID->
  "8e68be20-f03b-824e-9def-205679754697"],
 " for at most ",
 Cell[BoxData[
  StyleBox["maxGenerations", "TI"]], "InlineFormula",ExpressionUUID->
  "14ba5c16-c39a-504f-8b67-4b1ad42270e6"],
 " generations and gives the runtime, the lifetime and whether the evolution \
halted."
}], "Usage",
 CellID->814465914,ExpressionUUID->"fdec288c-ca0a-fe45-b210-2c26b15363af"],

Cell[TextData[{
 "The evolution is a canonical multiway evolution with the default limits and \
the given generation cap. Lifetime here is the breadth-first depth (number of \
nonempty generations minus one). It can be smaller than the longest \
derivation; use ",
 Cell[BoxData[
  TemplateBox[{
   "MultiwayLongestDerivation", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
MultiwayLongestDerivation", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/MultiwayLongestDerivation.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "de69a7b9-0772-d641-a863-cb0e42c19671"],
 " for that."
}], "Notes",
 CellID->558739616,ExpressionUUID->"5e51ab9e-1f6b-674d-8e05-4684c28cfb96"]
}, Open  ]],

