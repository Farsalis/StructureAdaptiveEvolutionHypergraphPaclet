Cell["RunDelayedTerminationMutations", "ObjectName",
 CellID->663307626,ExpressionUUID->"e3095be5-1857-9746-8d3a-bd7e580c2d89"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5214efc0-4a5b-0d4b-900d-24ead34e24f7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RunDelayedTerminationMutations",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
RunDelayedTerminationMutations"], 
   RowBox[{"[", 
    RowBox[{"rule", ",", " ", "evolveFunction", ",", " ", "iterations"}], 
    "]"}]}]], "InlineFormula",ExpressionUUID->
  "56dda457-28e9-5448-8bf5-09012bd86a03"],
 " \[LineSeparator]",
 "chains ",
 Cell[BoxData[
  StyleBox["iterations", "TI"]], "InlineFormula",ExpressionUUID->
  "b22a89ed-c869-d349-99ad-f01e9b22a52e"],
 " delayed-termination steps from ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "a34c727d-8ddc-2a49-9fb0-c46a4c5a6dcd"],
 "."
}], "Usage",
 CellID->999120303,ExpressionUUID->"af78f7c3-ccd4-1744-9fcb-0c26798fbd5f"],

Cell[TextData[{
 "Default ",
 StyleBox["iterations",
  FontSlant->Italic],
 ": 10. Each iteration continues from the rule accepted so far and appends \
its step result with \"Iteration\"."
}], "Notes",
 CellID->67161978,ExpressionUUID->"35ab2b01-69a2-4d4e-a3cc-b75fc1ed4825"],

Cell[TextData[{
 "This standalone hill-climbing step predates the central search; ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "c4a23afc-5a46-fa4c-9014-6c82c436077a"],
 " uses the mutation operators directly and evaluates candidates with one \
shared evaluator. The step gives an Association with \"AcceptedQ\", \"Rule\" \
(the mutant if accepted, else the input), \"CandidateRule\", \"OldFitness\" \
and \"NewFitness\"."
}], "Notes",
 CellID->962539402,ExpressionUUID->"dca46f5f-7c42-f646-b5c1-f95b66c4059d"]
}, Open  ]],

