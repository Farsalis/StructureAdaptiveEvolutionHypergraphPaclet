Cell[BoxData[
 RowBox[{"First", "[", 
  RowBox[{"SeedCorpus", "[", "]"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->798454447,ExpressionUUID->"f175a236-8cb5-1f41-b97f-a1b82205523a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Name\"\>", "\[Rule]", "\<\"EdgeContractionCycle4\"\>"}], ",", 
   
   RowBox[{"\<\"Rule\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], "}"}]}]}], ",", 
   RowBox[{"\<\"InitialState\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"EdgeSymmetry\"\>", "\[Rule]", "\<\"Unordered\"\>"}], ",", 
   RowBox[{"\<\"SymmetryGroups\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"Limits\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"MaxGenerations\"\>", "\[Rule]", "10"}], ",", 
      RowBox[{"\<\"MaxEvents\"\>", "\[Rule]", "2000"}], ",", 
      RowBox[{"\<\"MaxStates\"\>", "\[Rule]", "\[Infinity]"}], ",", 
      RowBox[{"\<\"TimeConstraint\"\>", "\[Rule]", "60.`"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"ExpectedStatus\"\>", "\[Rule]", "\<\"Halted\"\>"}], ",", 
   RowBox[{"\<\"Notes\"\>", 
    "\[Rule]", "\<\"Contraction shortens the cycle; in the simple unordered \
universe the triangle collapses to one edge, which no longer \
matches.\"\>"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->912981951,ExpressionUUID->"4765e896-2fde-7340-ac14-76886c4b7bde"]
}, Open  ]]
