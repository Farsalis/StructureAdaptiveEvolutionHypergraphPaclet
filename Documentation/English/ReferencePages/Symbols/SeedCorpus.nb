Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"EdgeContractionCycle4\"\>", ",", "\<\"Halted\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"EdgeContractionCycle6\"\>", ",", "\<\"Halted\"\>"}], "}"}], ",", 
