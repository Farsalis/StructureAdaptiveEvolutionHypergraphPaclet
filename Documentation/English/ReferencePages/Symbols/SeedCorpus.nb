Notebook[{

Cell[CellGroupData[{
Cell["SeedCorpus", "ObjectName",
 CellID->232091381,ExpressionUUID->"33b63955-da01-044f-95ff-2b9a84afb768"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a98688a8-4364-a644-8baf-c91ae5f472b2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SeedCorpus",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/SeedCorpus"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "c6e4de25-6c0d-ac45-bd70-c321c8490e8b"],
 " \[LineSeparator]",
 "gives the curated corpus of small seed systems with known statuses."
}], "Usage",
 CellID->918865987,ExpressionUUID->"f8794006-5e4e-134e-90ee-f30ec43e07c8"],

Cell[TextData[{
 "Each entry has \"Name\", \"Rule\", \"InitialState\", \"EdgeSymmetry\", \
\"SymmetryGroups\", \"Limits\", \"ExpectedStatus\" and \"Notes\". The corpus \
covers halting systems, cycles, growth that reaches a cap, a rule set, the \
ordered universe and a declared cyclic-symmetry universe; ",
 Cell[BoxData[
  TemplateBox[{
   "VerifySeedCorpus", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/VerifySeedCorpus", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/VerifySeedCorpus.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "9562b78b-14c7-214f-abc3-4c8e8b77e451"],
 " re-checks every expected status."
}], "Notes",
 CellID->697688973,ExpressionUUID->"392df192-1a9a-9a41-a94f-f57d340c7559"]
}, Open  ]],

