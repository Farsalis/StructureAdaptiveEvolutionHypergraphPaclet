    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"OrderedPathContraction\"\>", ",", "\<\"Halted\"\>"}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"\<\"SubdivisionGenerationCap\"\>", 
     ",", "\<\"GenerationCap\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"SubdivisionEventCap\"\>", ",", "\<\"EventCap\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"SubdivisionStateCap\"\>", ",", "\<\"StateCap\"\>"}], "}"}], ",", 
