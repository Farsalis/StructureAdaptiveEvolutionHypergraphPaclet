Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ae8630eb-ba3e-9446-b55d-5ad8d309d6ae"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["StrategyWeightPlot",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StrategyWeightPlot"], 
   RowBox[{"[", "result", "]"}]}]], "InlineFormula",ExpressionUUID->
  "5968cd9c-a4a0-0f45-8acc-e780cb319506"],
 " \[LineSeparator]",
 "plots the mutation-strategy weights of the \
[StructureAdaptiveEvolution](paclet:SamuelFrerichs/StructureAdaptiveEvolution/\
ref/StructureAdaptiveEvolution) result ",
 Cell[BoxData[
  StyleBox["result", "TI"]], "InlineFormula",ExpressionUUID->
  "9fa2867b-348d-e54e-a97c-cda4cc5e5b65"],
 " round by round."
}], "Usage",
 CellID->429706490,ExpressionUUID->"e104bc98-e6e1-d94f-b7c9-377d823ab318"],

Cell["\<\
Round 0 holds the initial weights. With \"AdaptiveWeights\" -> False the \
weights stay uniform and the plot label says they are fixed.\
\>", "Notes",
 CellID->428128787,ExpressionUUID->"a5a52985-1fde-5645-8977-0ddc16c23699"],

Cell["\<\
It uses only the data stored in the result; nothing is evolved or evaluated \
again.\
\>", "Notes",
 CellID->574761998,ExpressionUUID->"0b7fbbf2-35e7-4e40-a5f2-94875ead034a"]
}, Open  ]],

