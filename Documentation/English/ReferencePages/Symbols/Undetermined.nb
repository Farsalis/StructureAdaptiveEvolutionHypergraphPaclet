Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"loop", "=", 
   RowBox[{"EvaluateCandidate", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<CandidateID\>\"", "\[Rule]", "\"\<loop\>\""}], ",", 
       RowBox[{"\"\<Rule\>\"", "\[Rule]", 
        RowBox[{"CanonicalRuleForm", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"2", ",", "1"}], "}"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"\"\<InitialState\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], "}"}]}]}], "]"}], ",", 
     RowBox[{"ValidateEvolutionConfiguration", "[", 
      RowBox[{"Association", "[", "]"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"loop", "[", "\"\<Status\>\"", "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->943424387,ExpressionUUID->"4fca0ecf-78f0-db45-bd81-de2df8050d08"],

Cell[BoxData["\<\"CycleDetected\"\>"], "Output",
 CellLabel->"Out[1]=",
 CellID->507647198,ExpressionUUID->"f1949976-5084-f54a-9f5d-87bdc976c17e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KeyTake", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ClassifyCandidate", "[", 
     RowBox[{"loop", ",", 
      RowBox[{"{", "\"\<SpaceLike\>\"", "}"}]}], "]"}], 
    "[", "\"\<SpaceLike\>\"", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\"\<Satisfied\>\"", ",", "\"\<Evidence\>\"", 
     ",", "\"\<Claim\>\""}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->278896978,ExpressionUUID->"ace29f16-3cfd-5248-a642-aec2b7c233a0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Satisfied\"\>", "\[Rule]", "Undetermined"}], ",", 
   RowBox[{"\<\"Evidence\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"EffectiveDimensionEstimate\"\>", "\[Rule]", 
       RowBox[{"Missing", "[", "\<\"InsufficientStructure\"\>", "]"}]}], ",", 
      
      RowBox[{"\<\"DimensionVariance\"\>", "\[Rule]", 
       RowBox[{"Missing", "[", "\<\"InsufficientStructure\"\>", "]"}]}], ",", 
      
      RowBox[{"\<\"LargestComponentRatio\"\>", "\[Rule]", "1.`"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"Claim\"\>", 
    "\[Rule]", "\<\"Within the explored limits (status \\\"CycleDetected\\\": \
the reachable canonical state space was exhausted but contains a cycle), the \
SpaceLike criteria are undetermined because these values are undefined: \
EffectiveDimensionEstimate = Missing[\\\"InsufficientStructure\\\"] (required \
within 0.5 of 2.); DimensionVariance = Missing[\\\"InsufficientStructure\\\"] \
(required <= 0.25).\"\>"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->879219824,ExpressionUUID->"b5696e44-8ddf-6141-93b7-ac1d6eb5971e"]
}, Open  ]]
}, Open  ]],

