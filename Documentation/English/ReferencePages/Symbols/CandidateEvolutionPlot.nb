           TagBox[
            GridBox[{{
               RowBox[{"{", 
                 RowBox[{"1", ",", "2"}], "}"}]}, {
               RowBox[{"{", 
                 RowBox[{"1", ",", "3"}], "}"}]}, {
               RowBox[{"{", 
