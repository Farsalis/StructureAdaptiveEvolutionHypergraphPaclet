Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"StructureAdaptiveEvolution", "[", 
    RowBox[{
     RowBox[{"\"\<Rule\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], "}"}]}]}], ",", 
     RowBox[{"\"\<InitialState\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"\"\<Rounds\>\"", "\[Rule]", "2"}], ",", 
     RowBox[{"\"\<MutationBudget\>\"", "\[Rule]", "4"}], ",", 
     RowBox[{"\"\<EvolutionLimits\>\"", "\[Rule]", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "4"}], ",", 
        RowBox[{"\"\<MaxEvents\>\"", "\[Rule]", "300"}]}], "]"}]}], ",", 
     RowBox[{"\"\<InitialStateDiagnostics\>\"", "\[Rule]", "None"}], ",", 
     RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", "11"}]}], "]"}]}], ";", 
  RowBox[{"Length", "[", 
   RowBox[{"result", "[", "\"\<Candidates\>\"", "]"}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->692816551,ExpressionUUID->"750a323e-869c-7d48-b786-1bab804ebd3d"],

Cell[BoxData["7"], "Output",
 CellLabel->"Out[1]=",
 CellID->477959928,ExpressionUUID->"bd84f90f-257a-624f-8075-80e70f5ee4a7"]
}, Open  ]],

