Cell[CellGroupData[{
Cell["ClassifyCandidate", "ObjectName",
 CellID->602347830,ExpressionUUID->"e5eea8de-5b32-524a-b167-d94d673908b6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8ec79b27-761c-334a-bc25-32ec3af4287a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ClassifyCandidate",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/ClassifyCandidate"]\
, 
   RowBox[{"[", "candidate", "]"}]}]], "InlineFormula",ExpressionUUID->
  "da120b51-c0d7-3149-9e66-a3e3857a4c75"],
 " \[LineSeparator]",
 "applies the default classification criteria to the candidate record ",
 Cell[BoxData[
  StyleBox["candidate", "TI"]], "InlineFormula",ExpressionUUID->
  "abab1fc1-c44d-4747-b30d-3048d7a165b2"],
 ".",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ClassifyCandidate",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/ClassifyCandidate"]\
, 
   RowBox[{"[", 
    RowBox[{"candidate", ",", " ", "criteria"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"bfa69b94-700e-c344-9c13-abe4b1b7f08a"],
 " \[LineSeparator]",
 "uses ",
 Cell[BoxData[
  StyleBox["criteria", "TI"]], "InlineFormula",ExpressionUUID->
  "83e1bd1b-35a2-c84d-9c34-c6e8f2a8fc89"],
 ": Automatic, a list of default label names, or an Association ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",ExpressionUUID->
  "be6a888d-5bb3-a24b-8723-3aef0a515b01"],
 " -> ",
 Cell[BoxData[
  StyleBox["criterion", "TI"]], "InlineFormula",ExpressionUUID->
  "ef9acf72-d7c8-a943-9857-0f16aa2e1215"],
 ".",
 Cell["   ", "ModInfo",ExpressionUUID->"c8072e25-f487-7e42-8988-7c5d5278f53a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ClassifyCandidate",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/ClassifyCandidate"]\
, 
   RowBox[{"[", 
    RowBox[{"candidate", ",", " ", "criteria", ",", " ", "config"}], "]"}]}]],
   "InlineFormula",ExpressionUUID->"92b0db19-114b-024d-982e-3cdcc0e268bf"],
 " \[LineSeparator]",
 "computes missing metric values under the configuration ",
 Cell[BoxData[
  StyleBox["config", "TI"]], "InlineFormula",ExpressionUUID->
  "c43e5864-6b75-204a-9960-0409dfb4b790"],
 "."
}], "Usage",
 CellID->310856476,ExpressionUUID->"2cee95b9-b47a-1949-a615-cd208d8b076d"],

Cell[TextData[{
 "The default labels are \"RichTerminalStates\", \"SpaceLike\", \"Homogeneous\
\", \"LocallyStable\" and \"CausalInvariant\"; ",
 Cell[BoxData[
  TemplateBox[{
   "DefaultClassificationCriteria", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
DefaultClassificationCriteria", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/DefaultClassificationCriteria.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "949098a3-a66d-4941-ab22-7b1832fea2d7"],
 " gives their conditions and thresholds."
}], "Notes",
 CellID->479137535,ExpressionUUID->"9a12f5e8-7243-c14b-aef4-d3e83e3b519d"],

Cell[TextData[{
 "Metric values come from the candidate's \"Fitness\" when present and are \
otherwise computed with ",
 Cell[BoxData[
  TemplateBox[{
   "EvaluateCandidate", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/EvaluateCandidate", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/EvaluateCandidate.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "0b4091ca-d82b-6248-8525-f6d1c3902234"],
 " from its \"Rule\" and \"InitialState\". ",
 StyleBox["config",
  FontSlant->Italic],
 " may be options of ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "bf6e342b-d822-314b-9fc2-73bf5aaf97a1"],
 " or a normalized configuration such as a run's \"Configuration\"."
}], "Notes",
 CellID->331939077,ExpressionUUID->"456acb6a-d5c3-8949-b3a3-81214da63604"],

Cell[TextData[{
 "For each label the result gives \"Label\", \"Satisfied\" (True, False or ",
 Cell[BoxData[
  TemplateBox[{
   "Undetermined", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/Undetermined", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/Undetermined.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "e94a2a51-e4ab-b14e-a112-851e56eeef87"],
 "), \"Evidence\" (metric -> value), \"Criteria\", \"CriteriaStatus\" \
(\"Provisional\" for an unmodified default criterion, \"UserSupplied\" \
otherwise), \"Status\", \"ConditionResults\" and a \"Claim\" that states the \
evidence within the explored limits."
}], "Notes",
 CellID->596243442,ExpressionUUID->"76e08c61-07d2-2d4a-ba1b-64421d1d5242"],

Cell["\<\
The default thresholds are provisional: the project owner will review and \
revise them. A satisfied label is a structural classification within the \
explored limits, not evidence of any physical property.\
\>", "Notes",
 CellID->543241674,ExpressionUUID->"eb7f43f1-f39a-df4d-ae87-3c1fdd3b51be"]
}, Open  ]],

