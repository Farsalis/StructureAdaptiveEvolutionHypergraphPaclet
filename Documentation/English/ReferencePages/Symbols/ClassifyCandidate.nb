Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"candidate", "=", 
   RowBox[{"EvaluateCandidate", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<CandidateID\>\"", "\[Rule]", "\"\<contraction\>\""}], ",", 
       RowBox[{"\"\<Rule\>\"", "\[Rule]", 
        RowBox[{"CanonicalRuleForm", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3"}], "}"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"\"\<InitialState\>\"", "\[Rule]", 
        RowBox[{"CanonicalStateForm", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "1"}], "}"}]}], "}"}], "]"}]}]}], "]"}], ",", 
     RowBox[{"ValidateEvolutionConfiguration", "[", 
      RowBox[{"Association", "[", "]"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"candidate", "[", "\"\<Status\>\"", "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->370781611,ExpressionUUID->"5074e398-2648-d74d-90d8-2e74f4684082"],

Cell[BoxData["\<\"Halted\"\>"], "Output",
 CellLabel->"Out[1]=",
 CellID->498859187,ExpressionUUID->"de41f86a-bedb-c340-9ee1-94a5dba5b8a6"]
}, Open  ]],

