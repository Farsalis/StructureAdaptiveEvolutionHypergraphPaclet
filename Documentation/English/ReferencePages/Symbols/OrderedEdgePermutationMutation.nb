Cell["OrderedEdgePermutationMutation", "ObjectName",
 CellID->821224885,ExpressionUUID->"d3716ed6-362a-5b46-a7fe-8e8beaa17e84"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7187c133-d4b8-4149-8fe6-cc03a13521e7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["OrderedEdgePermutationMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
OrderedEdgePermutationMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "452b8f45-56c4-da4f-b83b-6052f5fe487b"],
 " \[LineSeparator]",
 "permutes the slots of one hyperedge of ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "b3e518fc-81ae-f546-9a42-fb7cc71bde7f"],
 ".",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["OrderedEdgePermutationMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
OrderedEdgePermutationMutation"], 
   RowBox[{"[", 
    RowBox[{"rule", ",", " ", "side"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"3d680d2a-7aa1-bd46-b058-53eefdf65829"],
 " \[LineSeparator]",
 "permutes an edge on the side ",
 Cell[BoxData[
  StyleBox["side", "TI"]], "InlineFormula",ExpressionUUID->
  "279fce04-4c1b-fd44-89a6-c4b4c3bbd979"],
 ", \"Left\" or \"Right\".",
 Cell["   ", "ModInfo",ExpressionUUID->
  "a51daad4-841f-1e44-9cf6-d125400d1fed"]
}], "Usage",
 CellID->212853820,ExpressionUUID->"b4cece64-1c77-ab4b-a627-e59021269327"],

Cell["\<\
Slot order only matters in the \"Ordered\" and \"Declared\" universes, so the \
operator requires one of them: in the default unordered universe it gives a \
Failure. Select it in a search with \"EdgeSymmetry\" -> \"Ordered\" and \
\"MutationStrategies\" -> {\"OrderedEdgePermutation\"}.\
\>", "Notes",
 CellID->120938758,ExpressionUUID->"c03ca0b1-7832-764f-bf10-a166d0879163"],

Cell[TextData[{
 "Mutations are random. The result is a rule, an Association with the keys \
\"Rule\" and \"Details\", or a Failure when no valid, canonically different \
mutant exists. Within ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "4ad906b1-8770-a046-a3ff-3721d0c87d9f"],
 " every operator that runs is recorded in the candidate's provenance."
}], "Notes",
 CellID->512616262,ExpressionUUID->"2a1dcb70-626e-b547-8314-ee01c10ddef1"]
}, Open  ]],

