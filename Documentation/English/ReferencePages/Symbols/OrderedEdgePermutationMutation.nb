Cell[BoxData[
 RowBox[{"Lookup", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"StructureAdaptiveEvolution", "[", 
     RowBox[{
      RowBox[{"\"\<Rule\>\"", "\[Rule]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}], "}"}]}]}], ",", 
      RowBox[{"\"\<InitialState\>\"", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "1"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"\"\<EdgeSymmetry\>\"", "\[Rule]", "\"\<Ordered\>\""}], ",", 
      RowBox[{"\"\<MutationStrategies\>\"", "\[Rule]", 
       RowBox[{"{", "\"\<OrderedEdgePermutation\>\"", "}"}]}], ",", 
      RowBox[{"\"\<Rounds\>\"", "\[Rule]", "1"}], ",", 
      RowBox[{"\"\<MutationBudget\>\"", "\[Rule]", "3"}], ",", 
      RowBox[{"\"\<EvolutionLimits\>\"", "\[Rule]", 
       RowBox[{"Association", "[", 
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "4"}], "]"}]}], ",", 
      RowBox[{"\"\<InitialStateDiagnostics\>\"", "\[Rule]", "None"}], ",", 
      RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", "5"}]}], "]"}], 
    "[", "\"\<Candidates\>\"", "]"}], ",", "\"\<Rule\>\""}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->234028988,ExpressionUUID->"234d6ccc-1d2d-684b-8196-b3dcf6cb4844"],

