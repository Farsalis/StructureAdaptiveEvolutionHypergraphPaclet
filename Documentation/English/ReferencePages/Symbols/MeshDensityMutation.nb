Notebook[{

Cell[CellGroupData[{
Cell["MeshDensityMutation", "ObjectName",
 CellID->636892647,ExpressionUUID->"24e0a6ad-8aba-4a4d-b429-14ed44b1e988"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"00d96717-a9d3-e44b-af13-bd083e6c9c0b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MeshDensityMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
MeshDensityMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "ddfd42ec-8b7c-574b-8c36-4af1a7ae9f2b"],
 " \[LineSeparator]",
 "proposes a mesh-density mutation of ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "ccae8b9f-6f5d-1949-bdc1-44c175e9b044"],
 ".",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["MeshDensityMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
MeshDensityMutation"], 
   RowBox[{"[", 
    RowBox[{"rule", ",", " ", 
     RowBox[{"<|", 
      RowBox[{"\"\<MaxRHSDegree\>\"", " ", "->", " ", "k"}], "|>"}]}], 
    "]"}]}]], "InlineFormula",ExpressionUUID->
  "218634d0-97d9-a743-8b7b-337d9a6d4045"],
 " \[LineSeparator]",
 "rejects proposals that raise the largest right-hand degree above ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "ee43769c-9f6f-d84f-bde2-5890a8b939b9"],
 ".",
 Cell["   ", "ModInfo",ExpressionUUID->
  "9708642a-5043-7449-b61f-379f127835d2"]
}], "Usage",
 CellID->648841623,ExpressionUUID->"900800aa-a27e-9b45-9170-d51a3e46682d"],

Cell["\<\
This is catalog strategy 7, \"MeshDensity\", of the approved 15-strategy \
mutation catalog.\
\>", "Notes",
 CellID->487760022,ExpressionUUID->"7737d4b4-2cce-1341-9df0-78a83bd95d0a"],

Cell["\<\
Operators: AddCycleMotif (close a 3- or 4-cycle), AddChainMotif (subdivide a \
right-hand edge) and ConservationMutate (rewire one right-hand slot, keeping \
the left-hand side, the right-hand edge count and the number of created \
vertices). The default \"MaxRHSDegree\" is 4, which keeps the mesh from \
forming star-like hubs.\
\>", "Notes",
 CellID->611173871,ExpressionUUID->"78f56914-c112-0b41-a333-e9acb7b94c28"],

Cell[TextData[{
 "The strategy is opt-in: select it with \"MutationStrategies\" -> \
{\"MeshDensity\"} in ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "a7da7d0a-9436-0a4f-88bc-1cd5500a67aa"],
 ", or with \"Goal\" -> \"MeshDensity\", whose preset also promotes the \
catalog's primary objectives for the strategy to Pareto objectives."
}], "Notes",
 CellID->143212406,ExpressionUUID->"b645c8ee-eb46-ba49-85c5-172cc49fe934"],

Cell["\<\
Mutations are random. The result is a canonically new rule (or rule set), an \
Association with \"Rule\" and \"Details\", or a Failure when no valid new \
proposal exists. Inside a search, every operator that ran is recorded in the \
candidate's provenance.\
\>", "Notes",
 CellID->111957981,ExpressionUUID->"b163e5e5-87fe-9041-9a97-d49d91431b5c"]
}, Open  ]],

