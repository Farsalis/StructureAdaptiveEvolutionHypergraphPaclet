Notebook[{

Cell[CellGroupData[{
Cell["DegreeBalancingMutation", "ObjectName",
 CellID->633180603,ExpressionUUID->"530979f1-8afc-d046-a430-37c5cd302f8c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8121727f-287b-6148-8b96-a2ad1eb0df41"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DegreeBalancingMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
DegreeBalancingMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "1760b949-c39e-1844-9116-29742c83d9fc"],
 " \[LineSeparator]",
 "proposes a degree-balancing mutation of ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "3a853dad-b33d-c94d-94bf-fb7f572e4d51"],
 "."
}], "Usage",
 CellID->475400439,ExpressionUUID->"f431ec3d-dadb-7e48-8566-5cd34cba293e"],

Cell["\<\
This is catalog strategy 12, \"DegreeBalancing\", of the approved 15-strategy \
mutation catalog.\
\>", "Notes",
 CellID->398449899,ExpressionUUID->"96fbb1eb-7558-f844-b49c-2c436ed964b2"],

Cell["\<\
Operators: SplitVariable (split a right-hand occurrence of the most reused \
right-hand variable) and ReduceVariableReuse (reroute one of its right-hand \
edges to a least-used variable).\
\>", "Notes",
 CellID->144231691,ExpressionUUID->"2e0a71da-aa3b-6a46-b7f3-b8a9650b5542"],

Cell[TextData[{
 "The strategy is opt-in: select it with \"MutationStrategies\" -> \
{\"DegreeBalancing\"} in ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "541b8dc6-657b-9a4f-ad58-6776547ea668"],
 ", or with \"Goal\" -> \"DegreeBalancing\", whose preset also promotes the \
catalog's primary objectives for the strategy to Pareto objectives."
}], "Notes",
 CellID->462630969,ExpressionUUID->"22eb6a7f-7c75-0847-851d-126a9e97e6fb"],

Cell["\<\
Mutations are random. The result is a canonically new rule (or rule set), an \
Association with \"Rule\" and \"Details\", or a Failure when no valid new \
proposal exists. Inside a search, every operator that ran is recorded in the \
candidate's provenance.\
\>", "Notes",
 CellID->175048571,ExpressionUUID->"f159af2b-aeaf-cb40-803b-7d539c5f99a0"]
}, Open  ]],

