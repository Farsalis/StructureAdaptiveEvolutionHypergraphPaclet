  RowBox[{
   ButtonBox["BranchialGraph",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/BranchialGraph"], 
   RowBox[{"[", 
    RowBox[{"evolution", ",", " ", "k"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"696a2702-3eb0-3a4b-a56a-f14ff9233428"],
