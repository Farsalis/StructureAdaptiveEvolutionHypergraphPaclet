Notebook[{

Cell[CellGroupData[{
Cell["HubPruningMutation", "ObjectName",
 CellID->873270802,ExpressionUUID->"de78195d-45f6-c64d-81ee-9cd7e0eaed19"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"34672d44-3e28-314b-9cf7-c3d10ae2b07c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HubPruningMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
HubPruningMutation"], 
   RowBox[{"[", "rules", "]"}]}]], "InlineFormula",ExpressionUUID->
  "940e9b0a-6e22-1f40-91aa-3a9d6c74b446"],
 " \[LineSeparator]",
 "proposes a hub-pruning mutation of a rule or rule set.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["HubPruningMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
HubPruningMutation"], 
   RowBox[{"[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"<|", 
      RowBox[{"\"\<ContractionDegree\>\"", " ", "->", " ", "k"}], "|>"}]}], 
    "]"}]}]], "InlineFormula",ExpressionUUID->
  "c11a7f4e-19cf-2447-87ba-b8345b65fb63"],
 " \[LineSeparator]",
 "sets the size of the contracted star.",
 Cell["   ", "ModInfo",ExpressionUUID->
  "53f046b4-dd8d-ae4c-aec2-31cbe1d7f1dd"]
}], "Usage",
 CellID->697290810,ExpressionUUID->"0f12c41f-c922-5b4e-97c7-9b77a6882d99"],

Cell["\<\
This is catalog strategy 14, \"HubPruning\", of the approved 15-strategy \
mutation catalog.\
\>", "Notes",
 CellID->756387055,ExpressionUUID->"b6400011-a4e2-2c4c-ae37-5730eaa2063a"],

Cell[TextData[{
 "Operators: ContractionRule with AddRule (add a rule rewriting a star of ",
 StyleBox["k",
  FontSlant->Italic],
 " edges into a path over its leaves; ",
 StyleBox["k",
  FontSlant->Italic],
 " Automatic follows the largest right-hand degree, clipped to 2..4) and \
DeleteRule (delete one member of a rule set with at least two members; a rule \
set never becomes empty)."
}], "Notes",
 CellID->627109117,ExpressionUUID->"032347d3-9970-fa4c-8cdb-6c93c946cce2"],

Cell["\<\
Rule sets are unordered: each member rule has its own variables and any \
member can fire.\
\>", "Notes",
 CellID->243340945,ExpressionUUID->"547427d7-35dc-5241-b699-d9c899358653"],

Cell[TextData[{
 "The strategy is opt-in: select it with \"MutationStrategies\" -> \
{\"HubPruning\"} in ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "28d1ebcd-a9b3-c545-abb3-68adf0cf0f13"],
 ", or with \"Goal\" -> \"HubPruning\", whose preset also promotes the \
catalog's primary objectives for the strategy to Pareto objectives."
}], "Notes",
 CellID->413847537,ExpressionUUID->"aa784e22-1b9a-8642-afa1-2412fb2cc105"],

Cell["\<\
Mutations are random. The result is a canonically new rule (or rule set), an \
Association with \"Rule\" and \"Details\", or a Failure when no valid new \
proposal exists. Inside a search, every operator that ran is recorded in the \
candidate's provenance.\
\>", "Notes",
 CellID->878297187,ExpressionUUID->"ad8a6996-c08a-524a-a82a-cdd25fe5ee21"]
}, Open  ]],

