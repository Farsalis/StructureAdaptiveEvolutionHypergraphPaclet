Notebook[{

Cell[CellGroupData[{
Cell["OverlappingMatchMutation", "ObjectName",
 CellID->500736293,ExpressionUUID->"6c1689c2-d7ff-7744-b4cd-fd9e7faa924b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"58e15b83-48d3-8745-a057-7ef6daa2af7a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["OverlappingMatchMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
OverlappingMatchMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "a0ac7a81-09bb-064a-8791-4b093086095f"],
 " \[LineSeparator]",
 "makes the left-hand side of ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "dfb570ff-e596-c343-8652-c0da0588a3b3"],
 " less specific, by deleting a condition edge or reducing an arity, so that \
more overlapping matches occur."
}], "Usage",
 CellID->806321076,ExpressionUUID->"caf0f9bf-bc8c-834b-837b-2f3b39397101"],

Cell["\<\
This is the operator of the OverlappingMatch strategy (catalog 6): broader \
multiway branching.\
\>", "Notes",
 CellID->314492810,ExpressionUUID->"2d231c41-874f-7b48-a440-937e369745e2"],

Cell[TextData[{
 "Mutations are random. The result is a rule, an Association with the keys \
\"Rule\" and \"Details\", or a Failure when no valid, canonically different \
mutant exists. Within ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "68125b95-045a-ec4a-b764-ca10ebc3f496"],
 " every operator that runs is recorded in the candidate's provenance."
}], "Notes",
 CellID->59035269,ExpressionUUID->"7bb0c873-94af-b143-bfcd-042ca17045f9"]
}, Open  ]],

