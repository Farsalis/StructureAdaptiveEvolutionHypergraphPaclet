Cell["\<\
An edge goes from a parent candidate to each candidate proposed from it; its \
tooltip names the strategy used.\
\>", "Notes",
 CellID->944679769,ExpressionUUID->"495a137a-9f12-3b47-84c2-901e21292592"],

Cell["\<\
It uses only the data stored in the result; nothing is evolved or evaluated \
again.\
\>", "Notes",
 CellID->282787867,ExpressionUUID->"c90d75e9-30bb-b34c-a1d6-f8402593c83b"]
}, Open  ]],

