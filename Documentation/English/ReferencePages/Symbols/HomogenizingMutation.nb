Notebook[{

Cell[CellGroupData[{
Cell["HomogenizingMutation", "ObjectName",
 CellID->611616540,ExpressionUUID->"8235c9bc-f1aa-7044-a922-f4df4c00ae0d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7a0d71c2-c4f0-3d40-b91d-30959f2611f5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HomogenizingMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
HomogenizingMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "6d63c4b6-5b8d-6c4e-bee9-e56442f44c71"],
 " \[LineSeparator]",
 "proposes a homogenizing mutation of ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "f4b05774-bf0d-fc46-975e-e5288da4643c"],
 "."
}], "Usage",
 CellID->919136172,ExpressionUUID->"b04aec41-e8e6-2345-9805-47e79b7b72c5"],

Cell["\<\
This is catalog strategy 8, \"Homogenizing\", of the approved 15-strategy \
mutation catalog.\
\>", "Notes",
 CellID->686013186,ExpressionUUID->"821b7240-b9a9-2541-b935-d754dea53631"],

Cell["\<\
Operators: SymmetrizeRHS (repeat a local right-hand template under an \
exchange of interchangeable variables, or twin a right-hand-only variable) \
and BoundaryPreserveRHS.\
\>", "Notes",
 CellID->171992732,ExpressionUUID->"2a8d41a4-4cf7-0e49-8699-9b2d43b2f275"],

Cell[TextData[{
 "The strategy is opt-in: select it with \"MutationStrategies\" -> \
{\"Homogenizing\"} in ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "3fa14c59-379a-b547-b7ba-1dde93fec028"],
 ", or with \"Goal\" -> \"Homogenizing\", whose preset also promotes the \
catalog's primary objectives for the strategy to Pareto objectives."
}], "Notes",
 CellID->822312615,ExpressionUUID->"c1b6f095-0f2c-d444-bcf8-7bedf94ecb47"],

Cell["\<\
Mutations are random. The result is a canonically new rule (or rule set), an \
Association with \"Rule\" and \"Details\", or a Failure when no valid new \
proposal exists. Inside a search, every operator that ran is recorded in the \
candidate's provenance.\
\>", "Notes",
 CellID->821003372,ExpressionUUID->"54dbb67f-59b8-a14a-9f05-7eb1707410af"]
}, Open  ]],

