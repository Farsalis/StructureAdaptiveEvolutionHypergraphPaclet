Cell[CellGroupData[{
Cell["DelayedTerminationMutation", "ObjectName",
 CellID->682184438,ExpressionUUID->"32474109-0921-4843-82a3-d5a31f6d08fa"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1da9e423-7571-0042-9533-33fff7ddb04e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DelayedTerminationMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
DelayedTerminationMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "851ad6d3-5922-5f44-be7a-7387d19e81a9"],
 " \[LineSeparator]",
 "proposes a single small right-hand growth or a new left-hand condition edge."
}], "Usage",
 CellID->102609661,ExpressionUUID->"b647469e-68b4-1449-b30a-9910446a337c"],

Cell["\<\
This is the operator of the DelayedTermination strategy (catalog 9): \
long-lived but finite systems.\
\>", "Notes",
 CellID->415716087,ExpressionUUID->"361e46cd-a2ce-f944-8aae-bce414b17a06"],

Cell[TextData[{
 "Mutations are random. The result is a rule, an Association with the keys \
\"Rule\" and \"Details\", or a Failure when no valid, canonically different \
mutant exists. Within ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "fd36015b-7994-144e-a1a3-3b4f7cc4bde8"],
 " every operator that runs is recorded in the candidate's provenance."
}], "Notes",
 CellID->165150046,ExpressionUUID->"418ac8b1-5776-8148-95af-7ef918a47fbb"]
}, Open  ]],

