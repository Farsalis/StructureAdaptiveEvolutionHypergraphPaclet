Notebook[{

Cell[CellGroupData[{
Cell["AddLHSConditionMutation", "ObjectName",
 CellID->155576818,ExpressionUUID->"3addeaf0-2f05-bc46-8302-385322fb0691"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9f2bbd48-f92a-9d46-83ef-6af28f8cec61"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AddLHSConditionMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
AddLHSConditionMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "af0146a6-f945-4346-b4a1-3e98fb55128f"],
 " \[LineSeparator]",
 "adds one left-hand hyperedge over existing left-hand variables, making the \
match more specific."
}], "Usage",
 CellID->449796748,ExpressionUUID->"af50969f-0644-8148-ade4-d6f904403933"],

Cell["\<\
A more specific left-hand side matches fewer states, which can make a growing \
rule stop.\
\>", "Notes",
 CellID->546972186,ExpressionUUID->"50a6da2b-7128-8648-bc5e-01f5bde4cec1"],

Cell[TextData[{
 "Mutations are random. The result is a rule, an Association with the keys \
\"Rule\" and \"Details\", or a Failure when no valid, canonically different \
mutant exists. Within ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "63a344a4-500e-cc4f-8a27-dbd313d22c70"],
 " every operator that runs is recorded in the candidate's provenance."
}], "Notes",
 CellID->746792366,ExpressionUUID->"20118030-8018-ee43-a5f3-3b8a3e624fde"]
}, Open  ]],

