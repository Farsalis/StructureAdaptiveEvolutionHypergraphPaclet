Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"config", "=", 
   RowBox[{"ValidateEvolutionConfiguration", "[", 
    RowBox[{"Association", "[", 
     RowBox[{"\"\<EvolutionLimits\>\"", "\[Rule]", 
      RowBox[{"Association", "[", 
       RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "5"}], "]"}]}], "]"}], 
    "]"}]}], ";", 
  RowBox[{"config", "[", "\"\<EvolutionLimits\>\"", "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->174763965,ExpressionUUID->"c1b1f1f4-de2a-8b4a-9a34-ccaddf462847"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"MaxGenerations\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"MaxEvents\"\>", "\[Rule]", "1000"}], ",", 
   RowBox[{"\<\"MaxStates\"\>", "\[Rule]", "\[Infinity]"}], ",", 
   RowBox[{"\<\"TimeConstraint\"\>", "\[Rule]", "30.`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->686146347,ExpressionUUID->"27b9e9dc-ea0f-e24d-a495-1e6faa18edd7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"candidate", "=", 
   RowBox[{"EvaluateCandidate", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<CandidateID\>\"", "\[Rule]", "\"\<example\>\""}], ",", 
       RowBox[{"\"\<Rule\>\"", "\[Rule]", 
        RowBox[{"CanonicalRuleForm", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3"}], "}"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"\"\<InitialState\>\"", "\[Rule]", 
        RowBox[{"CanonicalStateForm", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "4"}], "}"}]}], "}"}], "]"}]}]}], "]"}], ",", 
     "config"}], "]"}]}], ";", 
  RowBox[{"candidate", "[", "\"\<Status\>\"", "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->782193721,ExpressionUUID->"e889ff32-02c2-8a49-b804-2f67cb79c4ee"],

