Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"evolveStates", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CanonicalMultiwayEvolution", "[", 
      RowBox[{"#1", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "}"}], ",", 
       RowBox[{"Association", "[", 
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "3"}], "]"}]}], "]"}], 
     "[", "\"\<States\>\"", "]"}], "&"}]}], ";", 
  RowBox[{"Length", "[", 
   RowBox[{"evolveStates", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->604497012,ExpressionUUID->"6d42dcdd-f68d-b144-ae47-bf3d04eccd57"],

Cell[BoxData["4"], "Output",
 CellLabel->"Out[1]=",
 CellID->333831632,ExpressionUUID->"5900a8b0-e7b2-d642-b378-8b36c0ee713e"]
}, Open  ]],

