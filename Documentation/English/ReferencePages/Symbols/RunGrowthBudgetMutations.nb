Notebook[{

Cell[CellGroupData[{
Cell["RunGrowthBudgetMutations", "ObjectName",
 CellID->117111253,ExpressionUUID->"10e76a25-bca5-6748-ab29-b97ed250cc27"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"eb422081-e5fc-654f-8388-66f8a79f7920"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RunGrowthBudgetMutations",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
RunGrowthBudgetMutations"], 
   RowBox[{"[", 
    RowBox[{
    "rule", ",", " ", "evolveFunction", ",", " ", "iterations", ",", " ", 
     "tolerance"}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "01da82c1-8ab2-3449-a635-f62ba8d6b49c"],
 " \[LineSeparator]",
 "chains ",
 Cell[BoxData[
  StyleBox["iterations", "TI"]], "InlineFormula",ExpressionUUID->
  "63f81a7d-544d-1c4a-9cde-faa44674bae9"],
 " growth-budget steps from ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "f4d86a50-5efc-904f-97b4-70774c1fe07e"],
 "."
}], "Usage",
 CellID->934433898,ExpressionUUID->"70358798-3fbb-f849-8acf-441f607b4a47"],

Cell[TextData[{
 "Defaults: ",
 StyleBox["iterations",
  FontSlant->Italic],
 " 10, ",
 StyleBox["tolerance",
  FontSlant->Italic],
 " 0.2. Before each step the ratio range is (1 \[PlusMinus] ",
 StyleBox["tolerance",
  FontSlant->Italic],
 ") times the current maximum edge-to-vertex ratio, or {0, 1} when that ratio \
is 0. Each iteration continues from the rule accepted so far and appends its \
step result with \"Iteration\". Each entry also records its \"RatioRange\"."
}], "Notes",
 CellID->384417621,ExpressionUUID->"ea90945c-9343-1e40-afce-1f3f1843e460"],

Cell[TextData[{
 "This standalone hill-climbing step predates the central search; ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "6422c64c-420e-6544-954b-4f780983a149"],
 " uses the mutation operators directly and evaluates candidates with one \
shared evaluator. The step gives an Association with \"AcceptedQ\", \"Rule\" \
(the mutant if accepted, else the input), \"CandidateRule\", \"OldFitness\" \
and \"NewFitness\"."
}], "Notes",
 CellID->220501618,ExpressionUUID->"d860f7aa-224d-4c40-87dd-1d4619d0c9f7"]
}, Open  ]],

