Cell[CellGroupData[{
Cell["RunGrowThenConstrainMutations", "ObjectName",
 CellID->769129043,ExpressionUUID->"74216d6a-b58c-6140-ac32-86062681cc14"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a7c511ab-5f23-cb4a-94f4-c1fd8952f873"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RunGrowThenConstrainMutations",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
RunGrowThenConstrainMutations"], 
   RowBox[{"[", 
    RowBox[{
    "rule", ",", " ", "evolveFunction", ",", " ", "iterations", ",", " ", 
     "targetVertices", ",", " ", "targetEdges"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"6e1690c3-135a-1742-807c-46be30565eb2"],
 " \[LineSeparator]",
 "chains ",
 Cell[BoxData[
  StyleBox["iterations", "TI"]], "InlineFormula",ExpressionUUID->
  "fd7fda9e-6af1-e648-b3c2-2f45d53a9eff"],
 " grow-then-constrain steps from ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "4a4b2a02-125b-a545-b10f-a675e8d276fb"],
 "."
}], "Usage",
 CellID->976375804,ExpressionUUID->"3a0e825e-0e16-1342-96c1-4b9ef7d29916"],

Cell[TextData[{
 "Defaults: ",
 StyleBox["iterations",
  FontSlant->Italic],
 " 10, ",
 StyleBox["targetVertices",
  FontSlant->Italic],
 " 20, ",
 StyleBox["targetEdges",
  FontSlant->Italic],
 " 20. Each iteration continues from the rule accepted so far and appends its \
step result with \"Iteration\"."
}], "Notes",
 CellID->285756901,ExpressionUUID->"2acbdfb5-a0ec-594f-ad38-dde8e0d44385"],

Cell[TextData[{
 "This standalone hill-climbing step predates the central search; ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "d8e3cf8c-ac82-8843-8399-b63061549d54"],
 " uses the mutation operators directly and evaluates candidates with one \
shared evaluator. The step gives an Association with \"AcceptedQ\", \"Rule\" \
(the mutant if accepted, else the input), \"CandidateRule\", \"OldFitness\" \
and \"NewFitness\"."
}], "Notes",
 CellID->455266490,ExpressionUUID->"cc4c81d9-b95a-b244-9d9e-8f45332742e5"]
}, Open  ]],

