Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"evolveGenerations", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CanonicalMultiwayEvolution", "[", 
      RowBox[{"#1", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "}"}], ",", 
       RowBox[{"Association", "[", 
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "3"}], "]"}]}], "]"}], 
     "[", "\"\<Generations\>\"", "]"}], "&"}]}], ";", 
  RowBox[{"Length", "/@", 
   RowBox[{"evolveGenerations", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->107867565,ExpressionUUID->"cd5dad59-f65f-f54d-ae9f-0503ce5c7f52"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->553629843,ExpressionUUID->"65f76791-5a44-8747-95a7-105136661bd5"]
}, Open  ]],

