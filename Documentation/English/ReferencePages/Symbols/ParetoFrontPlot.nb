Cell[CellGroupData[{
Cell["ParetoFrontPlot", "ObjectName",
 CellID->100788036,ExpressionUUID->"4e641cde-4657-2d42-b541-97e705f4347c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"232a4285-9ac5-ab49-962b-0a17e42b1ea7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ParetoFrontPlot",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/ParetoFrontPlot"], 
   
   RowBox[{"[", 
    RowBox[{"result", ",", " ", 
     RowBox[{"{", 
      RowBox[{"metric1", ",", " ", "metric2"}], "}"}]}], "]"}]}]], 
  "InlineFormula",ExpressionUUID->"ad9bd947-192e-364f-a02d-bf184573b083"],
 " \[LineSeparator]",
 "plots two fitness metrics of all valid candidates, highlighting the search \
and solution Pareto fronts."
}], "Usage",
 CellID->877886571,ExpressionUUID->"4d503fea-cf34-4348-b7f1-211add42ffb0"],

Cell["\<\
Boolean metric values are plotted as 1 and 0. Tooltips show the candidate ID, \
strategy and status. The fronts are the stored fronts over all objectives, so \
a front member need not be extreme in the two plotted metrics.\
\>", "Notes",
 CellID->357365331,ExpressionUUID->"7a8f0772-a4da-ca47-a157-c2bfb3462c6c"],

Cell["\<\
It uses only the data stored in the result; nothing is evolved or evaluated \
again.\
\>", "Notes",
 CellID->143189848,ExpressionUUID->"6908ce08-e024-ae40-a764-9b4d0f130586"]
}, Open  ]],

