Notebook[{

Cell[CellGroupData[{
Cell["WilsonInterval", "ObjectName",
 CellID->431366452,ExpressionUUID->"4a220663-f62c-d447-a67e-8b1a1711f19e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d1fc71fd-e9a1-0a4b-b216-0517e10b6c09"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["WilsonInterval",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/WilsonInterval"], 
   RowBox[{"[", 
    RowBox[{"successes", ",", " ", "trials"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"62712c96-0cdf-b446-9822-3de6b39a2dfb"],
 " \[LineSeparator]",
 "gives the 95% Wilson score interval {",
 Cell[BoxData[
  StyleBox["lower", "TI"]], "InlineFormula",ExpressionUUID->
  "d11899a4-ef9e-a743-b09d-f164de0baed8"],
 ", ",
 Cell[BoxData[
  StyleBox["upper", "TI"]], "InlineFormula",ExpressionUUID->
  "946702e4-c545-134b-b697-40aa46e401b7"],
 "} for a binomial proportion.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["WilsonInterval",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/WilsonInterval"], 
   RowBox[{"[", 
    RowBox[{"successes", ",", " ", "trials", ",", " ", "level"}], "]"}]}]], 
  "InlineFormula",ExpressionUUID->"548d8fb4-5659-0041-9ffa-4b6665825496"],
 " \[LineSeparator]",
 "uses the confidence level ",
 Cell[BoxData[
  StyleBox["level", "TI"]], "InlineFormula",ExpressionUUID->
  "69eb45d7-846e-5d46-b476-1c2608315642"],
 ".",
 Cell["   ", "ModInfo",ExpressionUUID->
  "600480e8-8969-4641-a997-8e1edc87c6a3"]
}], "Usage",
 CellID->515543275,ExpressionUUID->"df4b2de8-63d9-3845-a7bb-8be7504314e9"],

Cell[TextData[{
 "With ",
 StyleBox["trials",
  FontSlant->Italic],
 " = 0 the interval is {0., 1.}. Wilson intervals stay inside [0, 1] and \
behave well for proportions near 0 or 1 and for small samples, which is the \
situation of success rates over a few replicated runs."
}], "Notes",
 CellID->405856251,ExpressionUUID->"830d01fe-dc68-db4c-b64e-87d41de6be64"]
}, Open  ]],

