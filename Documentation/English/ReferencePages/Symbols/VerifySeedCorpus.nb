Cell[CellGroupData[{
Cell["VerifySeedCorpus", "ObjectName",
 CellID->672723924,ExpressionUUID->"b7115e08-ad7e-cf4c-878a-af0229f5a18b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fdf583dc-5224-8849-95bd-37a7856fe620"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["VerifySeedCorpus",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/VerifySeedCorpus"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "c42d3d9a-2f3f-4944-8b60-6ef27fa2f7ad"],
 " \[LineSeparator]",
 "re-evaluates every entry of \
[SeedCorpus](paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/SeedCorpus) \
with a fresh canonical multiway evolution and reports whether each observed \
status equals its expected status.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["VerifySeedCorpus",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/VerifySeedCorpus"], 
   RowBox[{"[", "corpus", "]"}]}]], "InlineFormula",ExpressionUUID->
  "4dfd3641-0f21-7347-83d9-e5a0ebedd715"],
 " \[LineSeparator]",
 "verifies a list of entries of the same form.",
 Cell["   ", "ModInfo",ExpressionUUID->
  "98ae39f7-54cb-0646-bd2f-9b6fc980a6ec"]
}], "Usage",
 CellID->358177195,ExpressionUUID->"d6045709-67fc-6041-8623-2a923cccd1e1"],

Cell["\<\
\"AllMatchQ\" is True when every entry matches. Evaluations are not taken \
from any cache.\
\>", "Notes",
 CellID->380198813,ExpressionUUID->"152465d6-ba7c-0a4d-8455-9b1f83e1fcd5"]
}, Open  ]],

