Cell[CellGroupData[{
Cell["ImportEvolutionResult", "ObjectName",
 CellID->231411578,ExpressionUUID->"b42c1436-f21f-154b-a70c-c7496da54802"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"df9b1d76-6421-2744-a4c9-87fbc6b775ee"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ImportEvolutionResult",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
ImportEvolutionResult"], 
   RowBox[{"[", "dir", "]"}]}]], "InlineFormula",ExpressionUUID->
  "7b1bc506-320b-6944-b249-6b9d2da0d618"],
 " \[LineSeparator]",
 "reads a result written by \
[ExportEvolutionResult](paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
ExportEvolutionResult) after verifying the SHA256 of result.wxf against \
manifest.json."
}], "Usage",
 CellID->543067621,ExpressionUUID->"507fd96e-791c-124c-a25b-af80cfe52afa"],

Cell["\<\
The imported result is identical (SameQ) to the exported one; graphs are \
rebuilt from WXF's internal form. A missing file, a hash mismatch or an \
unreadable result gives a Failure.\
\>", "Notes",
 CellID->646002465,ExpressionUUID->"5fedfa92-cd7d-ea45-8894-7c101f82e5ad"]
}, Open  ]],

