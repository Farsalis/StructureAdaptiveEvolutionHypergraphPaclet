Cell["\<\
With fixed weights the strategies are chosen uniformly, a random-mutation \
baseline for the same budget:\
\>", "ExampleText",
 CellID->975576861,ExpressionUUID->"8b379f19-4e1e-ec45-ab5b-93ae658222ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"StructureAdaptiveEvolution", "[", 
   RowBox[{
    RowBox[{"\"\<Rule\>\"", "\[Rule]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
      RowBox[{"{", 
