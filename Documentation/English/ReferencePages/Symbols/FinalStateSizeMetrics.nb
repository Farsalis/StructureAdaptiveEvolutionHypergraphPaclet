Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4ed85974-d40c-e942-9ab1-3dcf8f313ce5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FinalStateSizeMetrics",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
FinalStateSizeMetrics"], 
   RowBox[{"[", "states", "]"}]}]], "InlineFormula",ExpressionUUID->
  "09a11e88-c049-cb41-acf2-682c1ee94300"],
 " \[LineSeparator]",
 "gives size metrics of the last state in the list ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",ExpressionUUID->
  "faa8ac14-625b-6c44-b2e6-c2a5e71374c0"],
 "."
}], "Usage",
 CellID->89062608,ExpressionUUID->"6af93817-b733-df49-9851-61101c1933fe"],

Cell[TextData[{
 "This is a single-way notion. For multiway systems use ",
 Cell[BoxData[
  TemplateBox[{
   "MultiwayFinalStateSizeMetrics", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
MultiwayFinalStateSizeMetrics", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/MultiwayFinalStateSizeMetrics.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "363db6ca-232b-0c4c-9952-c470fe48bd6e"],
 ", which looks at every terminal state."
}], "Notes",
 CellID->254111789,ExpressionUUID->"ee7381d6-1f54-174c-807b-1e0ab9b9ca0b"]
}, Open  ]],

