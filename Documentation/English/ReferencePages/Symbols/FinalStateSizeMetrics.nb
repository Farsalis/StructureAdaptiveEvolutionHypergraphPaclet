Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FinalStateSizeMetrics", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->652639969,ExpressionUUID->"aeaea173-0fe8-4f43-a060-8ba5564c0f4a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"FinalVertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ",", 
   RowBox[{"\<\"FinalEdges\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"FinalVertexCount\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"FinalEdgeCount\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"FinalEdgeToVertexRatio\"\>", "\[Rule]", 
    "0.6666666666666666`"}], ",", 
   RowBox[{"\<\"FinalDensity\"\>", "\[Rule]", "0.3333333333333333`"}], ",", 
   RowBox[{"\<\"FinalAltDensity\"\>", "\[Rule]", 
    TagBox[
     InterpretationBox[
      StyleBox["\<\"0.67\"\>",
       ShowStringCharacters->False],
      0.6666666666666666,
      AutoDelete->True],
     NumberForm[#, {3, 2}]& ]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->188701549,ExpressionUUID->"f6d10dce-0df7-004a-b2a2-5dbbfaacebf8"]
}, Open  ]]
}, Open  ]],

