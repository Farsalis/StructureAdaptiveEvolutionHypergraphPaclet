Cell[CellGroupData[{
Cell["MultiwayEvolutionGraph", "ObjectName",
 CellID->17439330,ExpressionUUID->"753d6153-6524-4943-967d-360f1059e743"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"139db134-fc85-3148-9796-bd32d0c39033"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MultiwayEvolutionGraph",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
MultiwayEvolutionGraph"], 
   RowBox[{"[", "evolution", "]"}]}]], "InlineFormula",ExpressionUUID->
  "ab88b67f-3fab-f34f-a295-2b38120bdc59"],
 " \[LineSeparator]",
 "unrolls the canonical states graph of the \
[CanonicalMultiwayEvolution](paclet:SamuelFrerichs/StructureAdaptiveEvolution/\
ref/CanonicalMultiwayEvolution) result ",
 Cell[BoxData[
  StyleBox["evolution", "TI"]], "InlineFormula",ExpressionUUID->
  "bd5971f2-2f16-944d-8364-e21da2cf5e8c"],
 " by generation, with vertices {",
 Cell[BoxData[
  StyleBox["state", "TI"]], "InlineFormula",ExpressionUUID->
  "a529bd01-69a8-8a47-9491-98d8d20e09c7"],
 ", ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "d35cfbea-64d5-1544-8117-9dbd8e4cdff7"],
 "} for states reachable in ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "e72c4d2e-a4d2-8044-8f76-77eb3babd4da"],
 " events.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["MultiwayEvolutionGraph",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
MultiwayEvolutionGraph"], 
   RowBox[{"[", 
    RowBox[{"evolution", ",", " ", "depth"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"cd7708b4-5d9c-c54e-bbc0-e5f05c7f79ca"],
 " \[LineSeparator]",
 "keeps generations up to ",
 Cell[BoxData[
  StyleBox["depth", "TI"]], "InlineFormula",ExpressionUUID->
  "2f656a82-82ae-e44c-afd2-cb216df77806"],
 ".",
 Cell["   ", "ModInfo",ExpressionUUID->
  "cf15e102-b911-2c46-bf61-d98ece4f4927"]
}], "Usage",
 CellID->228437977,ExpressionUUID->"e1fd9834-b5e0-d840-a618-b1bd190a4d1b"],

Cell["\<\
A state reachable at several depths appears once per depth, so the unrolled \
graph is acyclic even when the states graph has cycles. It is the basis of \
the branchial graphs.\
\>", "Notes",
 CellID->521420839,ExpressionUUID->"deaa065d-b23e-a54c-965f-88b82c9aa76e"]
}, Open  ]],

