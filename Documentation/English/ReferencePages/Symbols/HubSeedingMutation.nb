Notebook[{

Cell[CellGroupData[{
Cell["HubSeedingMutation", "ObjectName",
 CellID->668473202,ExpressionUUID->"db05895c-1110-9e4c-8d37-ad17c68b8406"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"11b5383c-6413-5b4e-8c43-4a053209ee65"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HubSeedingMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
HubSeedingMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "e539c86c-0c33-8646-a076-27ff1f3f5209"],
 " \[LineSeparator]",
 "proposes a hub-seeding mutation of ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "6b62356d-2a70-4346-92d8-da4f4587b390"],
 ".",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["HubSeedingMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
HubSeedingMutation"], 
   RowBox[{"[", 
    RowBox[{"rule", ",", " ", 
     RowBox[{"<|", 
      RowBox[{"\"\<StarEdges\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"min", ",", " ", "max"}], "}"}]}], "|>"}]}], "]"}]}]], 
  "InlineFormula",ExpressionUUID->"45ced12e-2ad5-5548-866b-99ce068334ee"],
 " \[LineSeparator]",
 "sets how many edges a new star attaches.",
 Cell["   ", "ModInfo",ExpressionUUID->
  "457995d0-a8e1-a542-892e-35168d0d488e"]
}], "Usage",
 CellID->708799080,ExpressionUUID->"a152e974-d567-d045-9af7-ac69ecd6efaa"],

Cell["\<\
This is catalog strategy 13, \"HubSeeding\", of the approved 15-strategy \
mutation catalog.\
\>", "Notes",
 CellID->877638496,ExpressionUUID->"9bda6feb-eeb6-be4b-aa37-a4bbf0fa60c0"],

Cell[TextData[{
 "Operators: IdentifyVariables (merge a variable into the most reused \
right-hand variable) and AddStarMotif (attach between ",
 StyleBox["min",
  FontSlant->Italic],
 " and ",
 StyleBox["max",
  FontSlant->Italic],
 " new edges to it; default {1, 2})."
}], "Notes",
 CellID->828449173,ExpressionUUID->"2fe89b7e-e5a6-6447-aafd-cebf9b738e42"],

Cell[TextData[{
 "The strategy is opt-in: select it with \"MutationStrategies\" -> \
{\"HubSeeding\"} in ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "0663b319-0d18-fa40-9081-4bd809baea38"],
 ", or with \"Goal\" -> \"HubSeeding\", whose preset also promotes the \
catalog's primary objectives for the strategy to Pareto objectives."
}], "Notes",
 CellID->847341112,ExpressionUUID->"359f58f0-9dcd-6148-8771-3d748526c240"],

Cell["\<\
Mutations are random. The result is a canonically new rule (or rule set), an \
Association with \"Rule\" and \"Details\", or a Failure when no valid new \
proposal exists. Inside a search, every operator that ran is recorded in the \
candidate's provenance.\
\>", "Notes",
 CellID->397683273,ExpressionUUID->"3854de7f-e67b-2e48-8126-26243adcfa4b"]
}, Open  ]],

