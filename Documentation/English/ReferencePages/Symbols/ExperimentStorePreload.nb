Cell[CellGroupData[{
Cell["ExperimentStorePreload", "ObjectName",
 CellID->7234303,ExpressionUUID->"5c161654-3ae8-c147-9db5-fa6416b51fb7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6b427f2f-1518-eb4f-b44f-54a2acd24ce8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExperimentStorePreload",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
ExperimentStorePreload"], 
   RowBox[{"[", "storeDir", "]"}]}]], "InlineFormula",ExpressionUUID->
  "1377a1dc-2d18-ff43-b419-b1588751daeb"],
 " \[LineSeparator]",
 "verifies every stored run and preloads its candidate behaviors for reuse in \
this session, and gives the number preloaded."
}], "Usage",
 CellID->567340659,ExpressionUUID->"5a309c56-01e0-5749-8f76-e981cc24a9ed"],

Cell["\<\
Behaviors are keyed by EvaluationID, which covers the evolution identity \
(rule, state, limits, universe, backend, rewrite semantics and implementation \
versions) and the metric specifications, so only identical evaluations are \
reused. TimedOut behaviors are left out because they depend on the machine.\
\>", "Notes",
 CellID->856149596,ExpressionUUID->"5b77bf1c-88ab-974d-9dd0-c47bdfc4d615"],

Cell[TextData[{
 "A later ",
