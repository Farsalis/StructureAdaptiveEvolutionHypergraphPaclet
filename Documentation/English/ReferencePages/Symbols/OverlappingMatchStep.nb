Notebook[{

Cell[CellGroupData[{
Cell["OverlappingMatchStep", "ObjectName",
 CellID->363126901,ExpressionUUID->"1ccafb16-4616-f14a-96d0-95ded5319c5f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1397321b-49df-3c48-9108-51ce97ad206f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["OverlappingMatchStep",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
OverlappingMatchStep"], 
   RowBox[{"[", 
    RowBox[{"rule", ",", " ", "evolveFunction"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"5436086e-34f0-3f44-b5ad-f3c26e885313"],
 " \[LineSeparator]",
 "applies \
[OverlappingMatchMutation](paclet:SamuelFrerichs/StructureAdaptiveEvolution/\
ref/OverlappingMatchMutation) to ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "5f5bbece-8225-9c46-a780-bd3534dfac0e"],
 " and accepts the mutant when it branches more."
}], "Usage",
 CellID->28390655,ExpressionUUID->"06e9898d-f421-a948-8cc7-aa0842d1e9c4"],

Cell[TextData[{
 StyleBox["evolveFunction",
  FontSlant->Italic],
 Cell[BoxData[
  TemplateBox[{
   "*r*] must give the generations of a multiway evolution of *r*. The mutant \
is accepted when its state count and maximum frontier size do not decrease \
and at least one increases.\n\nThis standalone hill-climbing step predates \
the central search; [StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "f763f7d3-e40a-d94e-8575-cb9670fdb1d7"],
 " uses the mutation operators directly and evaluates candidates with one \
shared evaluator. The step gives an Association with \"AcceptedQ\", \"Rule\" \
(the mutant if accepted, else the input), \"CandidateRule\", \"OldFitness\" \
and \"NewFitness\"."
}], "Notes",
 CellID->401736317,ExpressionUUID->"a634b582-78a1-a046-a5b5-04dac9ff44f3"]
}, Open  ]],

