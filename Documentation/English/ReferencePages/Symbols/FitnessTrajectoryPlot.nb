Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"StructureAdaptiveEvolution", "[", 
    RowBox[{
     RowBox[{"\"\<Rule\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], "}"}]}]}], ",", 
     RowBox[{"\"\<InitialState\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"\"\<Rounds\>\"", "\[Rule]", "2"}], ",", 
     RowBox[{"\"\<MutationBudget\>\"", "\[Rule]", "4"}], ",", 
     RowBox[{"\"\<EvolutionLimits\>\"", "\[Rule]", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "4"}], ",", 
        RowBox[{"\"\<MaxEvents\>\"", "\[Rule]", "300"}]}], "]"}]}], ",", 
     RowBox[{"\"\<InitialStateDiagnostics\>\"", "\[Rule]", "None"}], ",", 
     RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", "11"}]}], "]"}]}], ";", 
  RowBox[{"Length", "[", 
   RowBox[{"result", "[", "\"\<Candidates\>\"", "]"}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->187406579,ExpressionUUID->"899531d1-0fbe-dc4c-93d4-0a259ba055f3"],

Cell[BoxData["7"], "Output",
 CellLabel->"Out[1]=",
 CellID->291450148,ExpressionUUID->"2420b18c-62cc-9140-9482-734acae1566e"]
}, Open  ]],

