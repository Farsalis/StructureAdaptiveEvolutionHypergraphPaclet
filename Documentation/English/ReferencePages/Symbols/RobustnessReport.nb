Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"StructureAdaptiveEvolution", "[", 
    RowBox[{
     RowBox[{"\"\<Rule\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], "}"}]}]}], ",", 
     RowBox[{"\"\<InitialState\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"\"\<Rounds\>\"", "\[Rule]", "1"}], ",", 
     RowBox[{"\"\<MutationBudget\>\"", "\[Rule]", "4"}], ",", 
     RowBox[{"\"\<EvolutionLimits\>\"", "\[Rule]", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "4"}], ",", 
        RowBox[{"\"\<MaxEvents\>\"", "\[Rule]", "300"}]}], "]"}]}], ",", 
     RowBox[{"\"\<InitialStateDiagnostics\>\"", "\[Rule]", "None"}], ",", 
     RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", "1"}]}], "]"}]}], ";", 
  RowBox[{"Length", "[", 
   RowBox[{"result", "[", "\"\<SolutionParetoFront\>\"", "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->952626921,ExpressionUUID->"f463ebe1-0f88-fa40-ba37-d979b1f6d743"],

Cell[BoxData["1"], "Output",
 CellLabel->"Out[1]=",
 CellID->334629819,ExpressionUUID->"78091c5f-ce42-9c46-9340-1e8f545900bb"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"report", "=", 
   RowBox[{"RobustnessReport", "[", 
    RowBox[{"result", ",", 
     RowBox[{"\"\<EnsembleSize\>\"", "\[Rule]", "3"}]}], "]"}]}], ";", 
  RowBox[{"Keys", "[", "report", "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->69849911,ExpressionUUID->"1f135221-36ba-0447-8680-da457bec4a96"],

