Cell["RobustnessReport", "ObjectName",
 CellID->139655492,ExpressionUUID->"16a4a486-0d8f-fc4f-9e45-01eabe3679f9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2b63e6cf-3809-354d-906f-ebccfaae893e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RobustnessReport",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/RobustnessReport"], 
   RowBox[{"[", "result", "]"}]}]], "InlineFormula",ExpressionUUID->
  "dd05e565-9c5f-154d-9e2c-22ccd361aab8"],
 " \[LineSeparator]",
 "runs [CandidateRobustness](paclet:SamuelFrerichs/StructureAdaptiveEvolution/\
ref/CandidateRobustness) on every finalist of the result ",
 Cell[BoxData[
  StyleBox["result", "TI"]], "InlineFormula",ExpressionUUID->
  "a9d985ee-a9e4-8d41-b86d-2eb59bbb4ad5"],
 " with one shared initial-state corpus."
}], "Usage",
 CellID->282554615,ExpressionUUID->"25a7bd0a-20d3-9a4c-95cc-cf2d5ab3d96a"],

Cell[TextData[{
 "Finalists are the solution-front candidates, or the search-front candidates \
when the solution front is empty. The options are those of ",
 Cell[BoxData[
  TemplateBox[{
   "CandidateRobustness", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
CandidateRobustness", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/CandidateRobustness.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "ad047bd6-0a5b-a64d-819f-9defe3791cf6"],
 "."
}], "Notes",
 CellID->643059794,ExpressionUUID->"2bc67988-c4a9-e54d-9621-b5ba8eaaa625"]
}, Open  ]],

