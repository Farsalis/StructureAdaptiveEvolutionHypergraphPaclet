Cell[CellGroupData[{
Cell["SplitVariableMutation", "ObjectName",
 CellID->203272186,ExpressionUUID->"fa30aefc-5a03-c840-84b4-6ba9231882bb"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7407c7df-9205-6f49-ae18-27ff5f8712df"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SplitVariableMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
SplitVariableMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "e864fed1-0c72-2742-ba93-662c924bde00"],
 " \[LineSeparator]",
 "replaces one occurrence of a repeated variable of ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "a4100923-287a-564f-b306-2559cc1bd767"],
 " by a fresh variable."
}], "Usage",
 CellID->933368251,ExpressionUUID->"3d4ccb55-69d6-1547-8b4e-a01775e3876f"],

Cell["Edge counts and arities are unchanged.", "Notes",
 CellID->180362886,ExpressionUUID->"5c665b39-430c-0f4f-a7c8-7c71637541e0"],

Cell[TextData[{
 "Mutations are random. The result is a rule, an Association with the keys \
\"Rule\" and \"Details\", or a Failure when no valid, canonically different \
mutant exists. Within ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "65878c58-8279-5e47-ae44-1eaf776ecc31"],
 " every operator that runs is recorded in the candidate's provenance."
}], "Notes",
 CellID->78708964,ExpressionUUID->"c9f47788-d500-104d-9cdd-0276a4670855"]
}, Open  ]],

