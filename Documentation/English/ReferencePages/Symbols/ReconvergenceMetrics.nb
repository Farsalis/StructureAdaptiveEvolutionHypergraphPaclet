Notebook[{

Cell[CellGroupData[{
Cell["ReconvergenceMetrics", "ObjectName",
 CellID->489291131,ExpressionUUID->"33f9322e-aec1-6d40-95b4-9de76727e455"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"29340a64-ab41-bb4d-b7be-11fd0a8e374b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReconvergenceMetrics",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
ReconvergenceMetrics"], 
   RowBox[{"[", "g", "]"}]}]], "InlineFormula",ExpressionUUID->
  "8dbb2437-43b7-7844-a143-c0e672eb9e12"],
 " \[LineSeparator]",
 "analyzes how branches of the directed multiway graph ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "1bc96f12-4ee8-a345-b8a9-ede58159c359"],
 " reconverge after branch points.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReconvergenceMetrics",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
ReconvergenceMetrics"], 
   RowBox[{"[", 
    RowBox[{"g", ",", " ", "state"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"cb363878-f591-d647-a897-83cbd1ea3e61"],
 " \[LineSeparator]",
 "restricts the analysis to branch points reachable from ",
 Cell[BoxData[
  StyleBox["state", "TI"]], "InlineFormula",ExpressionUUID->
  "31b941b2-7194-f64f-9b68-be746618045a"],
 ".",
 Cell["   ", "ModInfo",ExpressionUUID->
  "6aee15df-0b7b-5248-8e18-a11b3ac981c6"]
}], "Usage",
 CellID->644707773,ExpressionUUID->"5264d77f-5c31-ca4a-b5e6-d88b4de12734"],

Cell[TextData[{
 "A branch point is a vertex with at least two successors. Two branches \
reconverge when their future cones in ",
 StyleBox["g",
  FontSlant->Italic],
 " intersect."
}], "Notes",
 CellID->585719066,ExpressionUUID->"6542fe88-7c64-d244-9ea1-6a0832c6e994"]
}, Open  ]],

