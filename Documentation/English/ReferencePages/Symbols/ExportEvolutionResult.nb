Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"StructureAdaptiveEvolution", "[", 
    RowBox[{
     RowBox[{"\"\<Rule\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], "}"}]}]}], ",", 
     RowBox[{"\"\<InitialState\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"\"\<Rounds\>\"", "\[Rule]", "1"}], ",", 
     RowBox[{"\"\<MutationBudget\>\"", "\[Rule]", "4"}], ",", 
     RowBox[{"\"\<EvolutionLimits\>\"", "\[Rule]", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "4"}], ",", 
        RowBox[{"\"\<MaxEvents\>\"", "\[Rule]", "300"}]}], "]"}]}], ",", 
     RowBox[{"\"\<InitialStateDiagnostics\>\"", "\[Rule]", "None"}], ",", 
     RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", "1"}]}], "]"}]}], ";", 
  RowBox[{"Length", "[", 
   RowBox[{"result", "[", "\"\<SolutionParetoFront\>\"", "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->543057632,ExpressionUUID->"3abe2dbe-973f-2a48-9728-58f64b869815"],

Cell[BoxData["1"], "Output",
 CellLabel->"Out[1]=",
 CellID->368416693,ExpressionUUID->"720e2660-273e-454d-a49f-4ef3282b9107"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"exported", "=", 
   RowBox[{"ExportEvolutionResult", "[", 
    RowBox[{"result", ",", 
     RowBox[{"CreateDirectory", "[", "]"}]}], "]"}]}], ";", 
  RowBox[{"FileNameTake", "/@", 
   RowBox[{"exported", "[", "\"\<Files\>\"", "]"}]}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->437609734,ExpressionUUID->"6579e553-5df5-9245-a255-3223a3e38116"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"result.wxf\"\>", ",", "\<\"manifest.json\"\>", 
   ",", "\<\"summary.md\"\>"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->901051126,ExpressionUUID->"3cc34172-3ae7-0f4d-af0b-d7adef6d53e7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ImportEvolutionResult", "[", 
   RowBox[{"exported", "[", "\"\<Directory\>\"", "]"}], "]"}], "===", 
  "result"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->916282539,ExpressionUUID->"dc29fd82-ab45-fc49-8c8e-b0e7d893df1c"],

