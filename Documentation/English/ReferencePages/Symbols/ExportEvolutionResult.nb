Notebook[{

Cell[CellGroupData[{
Cell["ExportEvolutionResult", "ObjectName",
 CellID->354309010,ExpressionUUID->"d687dad1-1b91-5444-b1c4-6fb084cbd1e3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dff4ab8e-6f39-fe47-a0d9-48a61a7976d5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportEvolutionResult",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
ExportEvolutionResult"], 
   RowBox[{"[", 
    RowBox[{"result", ",", " ", "dir"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"1b0c258b-b1d0-ca41-81a4-e625c471488e"],
 " \[LineSeparator]",
 "writes the \
[StructureAdaptiveEvolution](paclet:SamuelFrerichs/StructureAdaptiveEvolution/\
ref/StructureAdaptiveEvolution) result ",
 Cell[BoxData[
  StyleBox["result", "TI"]], "InlineFormula",ExpressionUUID->
  "0edc06af-1dd8-b54e-b9e2-b3d1b5860e23"],
 " to the directory ",
 Cell[BoxData[
  StyleBox["dir", "TI"]], "InlineFormula",ExpressionUUID->
  "b348a5c9-d57f-2743-a619-cdd3746ae16d"],
 " losslessly, with a run manifest and a readable summary."
}], "Usage",
 CellID->613909262,ExpressionUUID->"74a62294-9a90-1046-bc83-cbc05e6d8295"],

Cell["\<\
Files: result.wxf (the complete result, lossless WXF), manifest.json (the \
minimum run record: run ID, provenance and versions, the paclet's git commit \
or null, the JSON-safe normalized configuration, original and canonical seed, \
universe, rewrite semantics, canonical form, effective limits, random seed, \
strategies with initial and final weights, effective metric specifications, \
one row per candidate, verified terminal states of solution candidates, \
diagnostics summary and the SHA256 of result.wxf) and summary.md.\
\>", "Notes",
 CellID->816759331,ExpressionUUID->"42d60cda-2a31-f34b-856e-964ec11ac6f2"],

Cell[TextData[{
 "The result is <|\"Directory\" -> ",
 StyleBox["dir",
  FontSlant->Italic],
 ", \"Files\" -> {...}, \"WXFHash\" -> ",
 StyleBox["hash",
  FontSlant->Italic],
 "|>. ",
 Cell[BoxData[
  TemplateBox[{
   "ImportEvolutionResult", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
ImportEvolutionResult", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/ImportEvolutionResult.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "74c6a3df-02b7-894c-83e5-16a5bd94c3a6"],
 " reads it back and verifies the hash."
}], "Notes",
 CellID->853168866,ExpressionUUID->"2ac6e524-d4ac-a044-a784-f02e9cfbe954"]
}, Open  ]],

