Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Description\"\>", 
    "\[Rule]", "\<\"The exploration halted with several non-isomorphic \
verified terminal states of substantial mean size.\"\>"}], ",", 
   RowBox[{"\<\"AllOf\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"\<\"Metric\"\>", "\[Rule]", "\<\"HaltedWithinCapQ\"\>"}], ",", 
        RowBox[{"\<\"Test\"\>", "\[Rule]", "\<\"Equals\"\>"}], ",", 
        RowBox[{"\<\"Value\"\>", "\[Rule]", "True"}]}], 
       "\[RightAssociation]"}], ",", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"\<\"Metric\"\>", 
         "\[Rule]", "\<\"NonIsomorphicTerminalStateCount\"\>"}], ",", 
        RowBox[{"\<\"Test\"\>", "\[Rule]", "\<\"AtLeast\"\>"}], ",", 
        RowBox[{"\<\"Value\"\>", "\[Rule]", "3"}]}], "\[RightAssociation]"}], 
      ",", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"\<\"Metric\"\>", "\[Rule]", "\<\"FinalVertexCount\"\>"}], ",", 
        RowBox[{"\<\"Test\"\>", "\[Rule]", "\<\"AtLeast\"\>"}], ",", 
        RowBox[{"\<\"Value\"\>", "\[Rule]", "5"}]}], 
       "\[RightAssociation]"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->167158883,ExpressionUUID->"5a159a0d-3f87-6d48-8c91-f5765078a202"]
}, Open  ]],

Cell[CellGroupData[{

