Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Description\"\>", 
    "\[Rule]", "\<\"The explored states have a mean effective dimension \
estimate near the target, little variation of local dimension estimates and \
one dominant connected component.\"\>"}], ",", 
   RowBox[{"\<\"AllOf\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"\<\"Metric\"\>", 
         "\[Rule]", "\<\"EffectiveDimensionEstimate\"\>"}], ",", 
        RowBox[{"\<\"Test\"\>", "\[Rule]", "\<\"Within\"\>"}], ",", 
        RowBox[{"\<\"Value\"\>", "\[Rule]", "3.`"}], ",", 
        RowBox[{"\<\"Tolerance\"\>", "\[Rule]", "0.5`"}]}], 
       "\[RightAssociation]"}], ",", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"\<\"Metric\"\>", "\[Rule]", "\<\"DimensionVariance\"\>"}], ",", 
        RowBox[{"\<\"Test\"\>", "\[Rule]", "\<\"AtMost\"\>"}], ",", 
        RowBox[{"\<\"Value\"\>", "\[Rule]", "0.25`"}]}], 
       "\[RightAssociation]"}], ",", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"\<\"Metric\"\>", 
         "\[Rule]", "\<\"LargestComponentRatio\"\>"}], ",", 
        RowBox[{"\<\"Test\"\>", "\[Rule]", "\<\"AtLeast\"\>"}], ",", 
        RowBox[{"\<\"Value\"\>", "\[Rule]", "0.9`"}]}], 
       "\[RightAssociation]"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
