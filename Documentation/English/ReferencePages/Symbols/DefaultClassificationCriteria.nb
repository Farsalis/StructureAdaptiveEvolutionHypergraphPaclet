Cell[CellGroupData[{
Cell["DefaultClassificationCriteria", "ObjectName",
 CellID->405283346,ExpressionUUID->"b32b39ad-ea3e-0340-b89b-e66187b561f0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e7eef335-230e-8b4c-93b0-cd242bd3ee0b"],
