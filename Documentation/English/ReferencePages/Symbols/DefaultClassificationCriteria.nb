  RowBox[{"DefaultClassificationCriteria", "[", 
   RowBox[{"Association", "[", 
    RowBox[{"\"\<TargetDimension\>\"", "\[Rule]", "3.`"}], "]"}], "]"}], 
  "[", "\"\<SpaceLike\>\"", "]"}]], "Input",
