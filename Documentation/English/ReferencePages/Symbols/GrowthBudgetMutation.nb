Notebook[{

Cell[CellGroupData[{
Cell["GrowthBudgetMutation", "ObjectName",
 CellID->405844611,ExpressionUUID->"a928bf82-3156-e940-87bf-5a82376bbd2d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"99c6b1fd-bd27-ac48-93fb-d55081cfc21e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GrowthBudgetMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
GrowthBudgetMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "861a3367-647b-864e-9ee3-660097c63ed3"],
 " \[LineSeparator]",
 "adds one fresh right-hand variable and one or two right-hand hyperedges to ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "4687e288-1709-6741-9d4f-27993d3d8587"],
 "."
}], "Usage",
 CellID->30961155,ExpressionUUID->"f5d40759-0859-0c40-8eaf-41489258c907"],

Cell["\<\
This is the growth operator of the GrowthBudget strategy (catalog 1): larger \
states without density blowup. The strategy draws the number of added edges \
from its option \"AddedEdgesRange\" ({1, 2}); edges drawn twice are added \
once, so fewer edges than drawn can appear. With probability \
\"ConservationProbability\" (1/3) the strategy applies ConservationMutate \
instead, which rewires one right-hand slot while keeping the left-hand side, \
the number of right-hand edges and the number of created vertices.\
\>", "Notes",
 CellID->988979851,ExpressionUUID->"43c6d4f5-fc93-1f40-93dd-763f5cd50b51"],

Cell[TextData[{
 "Mutations are random. The result is a rule, an Association with the keys \
\"Rule\" and \"Details\", or a Failure when no valid, canonically different \
mutant exists. Within ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "8d888328-0463-3940-b563-81adc8de52b3"],
 " every operator that runs is recorded in the candidate's provenance."
}], "Notes",
 CellID->373641002,ExpressionUUID->"3b46eebc-de7f-4044-be61-c6c35b0cdb8a"]
}, Open  ]],

