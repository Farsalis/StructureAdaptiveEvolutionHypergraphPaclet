Cell[TextData[{
 "Layer ",
 StyleBox["k",
  FontSlant->Italic],
 " holds the canonical states reachable in exactly ",
 StyleBox["k",
  FontSlant->Italic],
 " events, read from the generation-unrolled ",
 Cell[BoxData[
  TemplateBox[{
   "MultiwayEvolutionGraph", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
MultiwayEvolutionGraph", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/MultiwayEvolutionGraph.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "6b4b0008-49ee-0544-9c55-4aa4cba65ded"],
 ". Two states of layer ",
 StyleBox["k",
  FontSlant->Italic],
 " are joined by an undirected edge when they share a parent state in layer \
",
 StyleBox["k",
  FontSlant->Italic],
 " - 1. Layer 0 holds the initial state alone."
}], "Notes",
 CellID->234718067,ExpressionUUID->"3a5054e1-72fb-7f4f-a4de-8c103511ff87"],

Cell["\<\
The evaluation artifact \"BranchialGraphs\" builds the same Association; the \
metrics BranchialMeanDegree and MeanBranchialDistance read it.\
\>", "Notes",
 CellID->822647877,ExpressionUUID->"fb55db0b-0012-8040-a06d-214b064b82c7"]
}, Open  ]],

