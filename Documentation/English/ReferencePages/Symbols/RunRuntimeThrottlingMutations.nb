Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"evolveGenerations", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CanonicalMultiwayEvolution", "[", 
      RowBox[{"#1", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "}"}], ",", 
       RowBox[{"Association", "[", 
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "3"}], "]"}]}], "]"}], 
     "[", "\"\<Generations\>\"", "]"}], "&"}]}], ";", 
  RowBox[{"Length", "/@", 
   RowBox[{"evolveGenerations", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->309265924,ExpressionUUID->"6af45961-e9cc-274e-abdd-fe0dde965350"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->996947812,ExpressionUUID->"77e6b83c-c0af-434b-8cdf-2f78b34cc632"]
}, Open  ]],

