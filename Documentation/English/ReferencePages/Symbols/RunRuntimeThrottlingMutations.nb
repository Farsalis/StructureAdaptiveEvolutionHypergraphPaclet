Cell[CellGroupData[{
Cell["RunRuntimeThrottlingMutations", "ObjectName",
 CellID->740985774,ExpressionUUID->"c7f1c0f8-b011-744e-899c-e685295ca390"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7becd177-3147-e449-b513-1c6f78903d9a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RunRuntimeThrottlingMutations",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
RunRuntimeThrottlingMutations"], 
   RowBox[{"[", 
    RowBox[{
    "rule", ",", " ", "evolveFunction", ",", " ", "iterations", ",", " ", 
     "retainedStateFraction"}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "bb2166cd-2416-2349-856c-8602132d62a0"],
 " \[LineSeparator]",
 "chains ",
 Cell[BoxData[
  StyleBox["iterations", "TI"]], "InlineFormula",ExpressionUUID->
  "37238f4d-e423-4a4d-a67e-400bd01daad2"],
 " runtime-throttling steps from ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "b76315a1-edcf-6847-a2be-3348a4029780"],
 "."
}], "Usage",
 CellID->691136131,ExpressionUUID->"185e5741-3ba7-3b46-ae89-92e4b3d4b68e"],

Cell[TextData[{
 "Defaults: ",
 StyleBox["iterations",
  FontSlant->Italic],
 " 10, ",
 StyleBox["retainedStateFraction",
  FontSlant->Italic],
 " 0.5. Each iteration continues from the rule accepted so far and appends \
its step result with \"Iteration\"."
}], "Notes",
 CellID->496859662,ExpressionUUID->"f28be05d-c35a-c14c-a6a9-a0f932072dec"],

Cell[TextData[{
 "This standalone hill-climbing step predates the central search; ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "71fd10f4-3713-9b4a-b288-72b7d0dbf102"],
 " uses the mutation operators directly and evaluates candidates with one \
shared evaluator. The step gives an Association with \"AcceptedQ\", \"Rule\" \
(the mutant if accepted, else the input), \"CandidateRule\", \"OldFitness\" \
and \"NewFitness\"."
}], "Notes",
 CellID->310094595,ExpressionUUID->"147881e3-e075-5745-87c0-9f312a921f32"]
}, Open  ]],

