Cell[BoxData["\<\"Discovery report: candidate \
80252ba934ff39352409de560934eb40e51f12b755df276e9c73a8a333025919 of run \
a915750f-75dc-456b-9b3f-135a6cdf4cbd\\nCandidate ID / evaluation ID: \
80252ba934ff39352409de560934eb40e51f12b755df276e9c73a8a333025919 / \
80503837de1b4f1c0e20bb42b4886112c021fc1fe233e89c8491ba74ba08dd7c (run \
a915750f-75dc-456b-9b3f-135a6cdf4cbd)\\nCanonical rule: {{1, 2}, {2, 3}} -> \
{{3}} (signature {{2, 2}} -> {{1, 1}})\\nInitial state: {{1, 2}, {1, 3}, {2, \
4}, {3, 4}} (canonical; 4 edges, 4 vertices)\\nEdge symmetry: Unordered; \
state equivalence ExactCanonical-UnorderedSimple\\nRewrite semantics: \
EdgeToken\\nBackend and versions: CanonicalBFS backend, Exact canonical form, \
evaluator 2.0, paclet 2.0.0, Hypergraph paclet 1.2.3, Wolfram 15.0.1 for \
Microsoft Windows (64-bit) (July 2, 2026)\\nLimits and random seed: \
MaxGenerations 4, MaxEvents 300, MaxStates Infinity, TimeConstraint 30.; \
random seed 1\\nStatus\"\>"], "Output",
 CellLabel->"Out[1]=",
 CellID->894772373,ExpressionUUID->"eae0006f-2354-0842-804d-5e2f0f7d11b5"]
}, Open  ]]
}, Open  ]],

