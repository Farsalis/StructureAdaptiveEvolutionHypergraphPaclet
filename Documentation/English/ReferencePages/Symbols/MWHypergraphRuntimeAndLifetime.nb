Cell[CellGroupData[{
Cell["MWHypergraphRuntimeAndLifetime", "ObjectName",
 CellID->615153647,ExpressionUUID->"7e76bd6e-b724-2e45-919f-5708bf9b5c85"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"01857fcb-deb0-0d4c-ba5f-8130bd3c5a2a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MWHypergraphRuntimeAndLifetime",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
MWHypergraphRuntimeAndLifetime"], 
   RowBox[{"[", 
    RowBox[{"rule", ",", " ", "state"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"114a6d90-8c36-d341-af9a-d090f360b1ca"],
 " \[LineSeparator]",
 "gives the multiway runtime and lifetime of ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "aa3ecc01-8c5e-0f4f-9c1b-25a35c0387ca"],
 " from ",
 Cell[BoxData[
  StyleBox["state", "TI"]], "InlineFormula",ExpressionUUID->
  "3696d665-a185-214b-adf7-c77245444353"],
 " under the default evolution limits."
}], "Usage",
 CellID->798757563,ExpressionUUID->"c68fe089-1a23-0340-b504-bd5b5c93312a"],

Cell[TextData[{
 "Lifetime here is the breadth-first depth (number of nonempty generations \
minus one). It can be smaller than the longest derivation; use ",
 Cell[BoxData[
  TemplateBox[{
   "MultiwayLongestDerivation", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
MultiwayLongestDerivation", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/MultiwayLongestDerivation.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "4fa5f31b-9052-3449-b1b4-9a46af96a2ff"],
 " for that."
}], "Notes",
 CellID->377576276,ExpressionUUID->"f051f978-552b-944d-be02-e1b5e1c1420e"]
}, Open  ]],

