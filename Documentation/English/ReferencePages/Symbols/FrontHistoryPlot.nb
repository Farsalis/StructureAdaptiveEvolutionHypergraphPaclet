Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"702e135f-7951-f742-9293-b835893763da"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FrontHistoryPlot",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/FrontHistoryPlot"], 
   RowBox[{"[", "result", "]"}]}]], "InlineFormula",ExpressionUUID->
  "6c566b1a-ad61-ca4e-8607-362f31cb4001"],
 " \[LineSeparator]",
 "plots the sizes of the search and solution Pareto fronts after every round \
of the [StructureAdaptiveEvolution](paclet:SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution) result ",
 Cell[BoxData[
  StyleBox["result", "TI"]], "InlineFormula",ExpressionUUID->
  "3f35eed1-a559-4946-a0c1-0d13f6fca851"],
 "."
}], "Usage",
 CellID->198582121,ExpressionUUID->"0147fed9-c38f-ef46-8acc-52abec7ea8d4"],

Cell["\<\
The function gives a Failure when the result has no completed rounds.\
\>", "Notes",
 CellID->173701012,ExpressionUUID->"1bd7a801-a39d-844d-9140-a25ee7f23ebf"],

Cell["\<\
It uses only the data stored in the result; nothing is evolved or evaluated \
again.\
\>", "Notes",
 CellID->830071346,ExpressionUUID->"b05385d9-d685-df44-a480-5cd40d0a64cb"]
}, Open  ]],

