Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"StructureAdaptiveEvolution", "[", 
    RowBox[{
     RowBox[{"\"\<Rule\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], "}"}]}]}], ",", 
     RowBox[{"\"\<InitialState\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"\"\<Rounds\>\"", "\[Rule]", "2"}], ",", 
     RowBox[{"\"\<MutationBudget\>\"", "\[Rule]", "4"}], ",", 
     RowBox[{"\"\<EvolutionLimits\>\"", "\[Rule]", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "4"}], ",", 
        RowBox[{"\"\<MaxEvents\>\"", "\[Rule]", "300"}]}], "]"}]}], ",", 
     RowBox[{"\"\<InitialStateDiagnostics\>\"", "\[Rule]", "None"}], ",", 
     RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", "11"}]}], "]"}]}], ";", 
  RowBox[{"Length", "[", 
   RowBox[{"result", "[", "\"\<Candidates\>\"", "]"}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->256275157,ExpressionUUID->"df15301a-8765-a24b-ad4b-43119607085b"],

Cell[BoxData["7"], "Output",
 CellLabel->"Out[1]=",
 CellID->545288672,ExpressionUUID->"037c069e-23f5-9d42-9c0e-993306844a8c"]
}, Open  ]],

