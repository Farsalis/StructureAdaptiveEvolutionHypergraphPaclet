Notebook[{

Cell[CellGroupData[{
Cell["EffectiveDimensionEstimate", "ObjectName",
 CellID->922646464,ExpressionUUID->"e11ace4e-8976-c04c-9b73-4b777f407e7f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"40120608-073f-754e-b7a0-d0ec5b7f8c23"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EffectiveDimensionEstimate",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
EffectiveDimensionEstimate"], 
   RowBox[{"[", "state", "]"}]}]], "InlineFormula",ExpressionUUID->
  "052bad7a-d4d9-b44e-a992-593f0c7b6d31"],
 " \[LineSeparator]",
 "estimates the effective dimension of the hypergraph ",
 Cell[BoxData[
  StyleBox["state", "TI"]], "InlineFormula",ExpressionUUID->
  "d069fcdd-144e-b347-8b09-7dca72b7be05"],
 " from the growth of neighborhood volumes with radius."
}], "Usage",
 CellID->439423981,ExpressionUUID->"37f71bc8-011b-b948-a5d5-4d51f174ee25"],

Cell["\<\
The estimate uses the undirected simple projection of the state. When the \
state is too small for an estimate the result is \
Missing[\"InsufficientStructure\"] rather than 0.\
\>", "Notes",
 CellID->149143319,ExpressionUUID->"05d2d825-8091-0f42-9f76-d8569d44ee3f"],

Cell["\<\
The estimate is a structural statistic of a finite graph. It is not evidence \
of any physical dimension.\
\>", "Notes",
 CellID->51464117,ExpressionUUID->"def1865f-bb3b-894a-8031-8c8616249044"]
}, Open  ]],

