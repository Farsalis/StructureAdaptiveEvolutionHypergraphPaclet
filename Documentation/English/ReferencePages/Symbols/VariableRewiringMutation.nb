Notebook[{

Cell[CellGroupData[{
Cell["VariableRewiringMutation", "ObjectName",
 CellID->33280388,ExpressionUUID->"bbf85bc1-5823-eb43-a7dc-054f9650375e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c5f0a9d9-c96f-524d-b175-dfb225af7d6c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["VariableRewiringMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
VariableRewiringMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "ef021231-87c9-e74e-8b46-2eca49e03145"],
 " \[LineSeparator]",
 "applies a variable-level point mutation to ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "ae1b815d-2e3f-7149-8127-13cf061accb6"],
 ": it identifies two variables or splits one occurrence."
}], "Usage",
 CellID->679486737,ExpressionUUID->"c6eabe0b-a34a-9849-9126-de70bc545ff8"],

Cell["\<\
This is the operator of the VariableRewiring strategy, which is outside the \
15-strategy catalog.\
\>", "Notes",
 CellID->424517043,ExpressionUUID->"3291167e-8d5d-6a4b-a326-5031044b5c31"],

Cell[TextData[{
 "Mutations are random. The result is a rule, an Association with the keys \
\"Rule\" and \"Details\", or a Failure when no valid, canonically different \
mutant exists. Within ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "4e750aab-6174-8547-8f1c-eac8a8df1f27"],
 " every operator that runs is recorded in the candidate's provenance."
}], "Notes",
 CellID->900222465,ExpressionUUID->"1f28c08c-7b32-0340-8918-7bd307399e2f"]
}, Open  ]],

