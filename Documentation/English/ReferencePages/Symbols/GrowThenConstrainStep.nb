Cell[CellGroupData[{
Cell["GrowThenConstrainStep", "ObjectName",
 CellID->955369686,ExpressionUUID->"c4253382-817c-d746-a2cf-b90e8e8fa5d6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a16edfa8-7344-3f4a-a341-e8b2be53689c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GrowThenConstrainStep",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
GrowThenConstrainStep"], 
   RowBox[{"[", 
    RowBox[{
    "rule", ",", " ", "evolveFunction", ",", " ", "targetVertices", ",", " ", 
     "targetEdges"}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "91959065-782a-d44b-bdf6-c7ec5ad6a666"],
 " \[LineSeparator]",
 "performs one grow-then-constrain step from ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "1e329a8e-a360-444b-bf61-545d1b21a6eb"],
 "."
}], "Usage",
 CellID->914679996,ExpressionUUID->"f62c1a2c-a507-1941-bc89-6a7ec9d6d853"],

Cell[TextData[{
 StyleBox["evolveFunction",
  FontSlant->Italic],
 Cell[BoxData[
  TemplateBox[{
   "*r*] must give the generations of a multiway evolution of *r* (a list of \
lists of states). The step grows while the parent's maximum vertex or edge \
count is below *targetVertices* or *targetEdges* (default 20 each) and \
constrains afterwards. A growth mutant is accepted when the vertex and edge \
maxima do not decrease and one increases; a constrained mutant when it halts \
within the cap and still reaches both targets.\n\nThis standalone \
hill-climbing step predates the central search; [StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "f916478b-cb82-684a-a0cd-2dcb471a352c"],
 " uses the mutation operators directly and evaluates candidates with one \
shared evaluator. The step gives an Association with \"AcceptedQ\", \"Rule\" \
(the mutant if accepted, else the input), \"CandidateRule\", \"OldFitness\" \
and \"NewFitness\"."
}], "Notes",
 CellID->57610926,ExpressionUUID->"a4f58728-c4de-ed4d-b4ad-af85f8eb1c25"]
}, Open  ]],

