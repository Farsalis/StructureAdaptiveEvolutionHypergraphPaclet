Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"evolveGenerations", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CanonicalMultiwayEvolution", "[", 
      RowBox[{"#1", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "}"}], ",", 
       RowBox[{"Association", "[", 
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "3"}], "]"}]}], "]"}], 
     "[", "\"\<Generations\>\"", "]"}], "&"}]}], ";", 
  RowBox[{"Length", "/@", 
   RowBox[{"evolveGenerations", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->249890514,ExpressionUUID->"684abcd8-1a4d-8645-884e-757860b3f8fc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->41918881,ExpressionUUID->"cc665a2c-f3d0-f543-b59c-e5e453b7e553"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BlockRandom", "[", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "2", "]"}], ";", 
   RowBox[{"GrowThenConstrainStep", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], ",", "evolveGenerations", 
     ",", "3", ",", "3"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->307226356,ExpressionUUID->"c803d021-4862-e94f-a98c-19d780cb2c1a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"AcceptedQ\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"Phase\"\>", "\[Rule]", "\<\"Constrain\"\>"}], ",", 
   RowBox[{"\<\"Rule\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}]}], ",", 
   RowBox[{"\<\"CandidateRule\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"3", ",", "2"}], "}"}], "}"}]}]}], ",", 
   RowBox[{"\<\"OldFitness\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"HGMaxVerticesCount\"\>", "\[Rule]", "6"}], ",", 
      RowBox[{"\<\"HGMaxEdgesCount\"\>", "\[Rule]", "5"}], ",", 
      RowBox[{"\<\"MultiwayStateCount\"\>", "\[Rule]", "4"}], ",", 
      RowBox[{"\<\"MaxMultiwayFrontierSize\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"MultiwayLifetime\"\>", "\[Rule]", "3"}], ",", 
      RowBox[{"\<\"HaltedWithinCapQ\"\>", "\[Rule]", "False"}], ",", 
      RowBox[{"\<\"Runtime\"\>", "\[Rule]", "0.1862898`"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"NewFitness\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"HGMaxVerticesCount\"\>", "\[Rule]", "4"}], ",", 
      RowBox[{"\<\"HGMaxEdgesCount\"\>", "\[Rule]", "2"}], ",", 
      RowBox[{"\<\"MultiwayStateCount\"\>", "\[Rule]", "2"}], ",", 
      RowBox[{"\<\"MaxMultiwayFrontierSize\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"MultiwayLifetime\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"HaltedWithinCapQ\"\>", "\[Rule]", "False"}], ",", 
      RowBox[{"\<\"Runtime\"\>", "\[Rule]", "0.0928794`"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->578354322,ExpressionUUID->"82c00ddf-7dd1-fd4f-bcbb-7abc0d5feef4"]
}, Open  ]]
}, Open  ]],

