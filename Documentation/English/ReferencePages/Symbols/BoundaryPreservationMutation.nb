Notebook[{

Cell[CellGroupData[{
Cell["BoundaryPreservationMutation", "ObjectName",
 CellID->674964418,ExpressionUUID->"42284904-3426-da40-ab4f-08422b19be0a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b485fe4b-c706-224c-b9a2-fb85df2aba8c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["BoundaryPreservationMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
BoundaryPreservationMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "4b965873-ec47-a944-ab22-647e4293ea6b"],
 " \[LineSeparator]",
 "proposes a boundary-preservation mutation of ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "7b12d8cd-4945-6b40-aa74-39eccbe8f9c4"],
 "."
}], "Usage",
 CellID->531920407,ExpressionUUID->"94dd8f48-93a7-3b4e-92af-286171f2e2a5"],

Cell["\<\
This is catalog strategy 4, \"BoundaryPreservation\", of the approved \
15-strategy mutation catalog.\
\>", "Notes",
 CellID->297038183,ExpressionUUID->"583f50d5-976a-ea40-b0c5-2acf0b114ec9"],

Cell["\<\
Operators: BoundaryPreserveRHS (attach every right-hand component without a \
left-hand variable to the boundary and restore dropped left-hand variables) \
and DeleteDisconnectedRHS (delete such components).\
\>", "Notes",
 CellID->240223496,ExpressionUUID->"e4f2584c-f052-5549-aae3-0a7234795184"],

Cell[TextData[{
 "The strategy is opt-in: select it with \"MutationStrategies\" -> \
{\"BoundaryPreservation\"} in ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "36ab5d7c-772d-cf46-bbb7-47c604a6a623"],
 ", or with \"Goal\" -> \"BoundaryPreservation\", whose preset also promotes \
the catalog's primary objectives for the strategy to Pareto objectives."
}], "Notes",
 CellID->355613348,ExpressionUUID->"087bc7d6-f9ea-8441-a9ee-14a945c3cefc"],

Cell["\<\
Mutations are random. The result is a canonically new rule (or rule set), an \
Association with \"Rule\" and \"Details\", or a Failure when no valid new \
proposal exists. Inside a search, every operator that ran is recorded in the \
candidate's provenance.\
\>", "Notes",
 CellID->527439941,ExpressionUUID->"fbcc76c4-c816-1e43-b5ad-4e86b53fcbae"]
}, Open  ]],

