Notebook[{

Cell[CellGroupData[{
Cell["GrowThenConstrainMutation", "ObjectName",
 CellID->358879321,ExpressionUUID->"36b570a2-8c63-5442-b4d6-88610ef9f3c1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0d4c8ded-a579-c64c-9c6b-7dc3f59be70c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GrowThenConstrainMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
GrowThenConstrainMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "e133fc2f-2098-9a44-8c49-df7cd0ef3286"],
 " \[LineSeparator]",
 "proposes either a growth mutation or a constraining mutation of ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "a9002cf8-4e82-644e-aa8c-2ff91d21a4bf"],
 ".",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["GrowThenConstrainMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
GrowThenConstrainMutation"], 
   RowBox[{"[", 
    RowBox[{"rule", ",", " ", "\"\<Grow\>\""}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"cbbce7c1-4ae3-e54c-97bb-289cffc383aa"],
 " \[LineSeparator]",
 "and `GrowThenConstrainMutation[rule, \"Constrain\"]` choose the phase.",
 Cell["   ", "ModInfo",ExpressionUUID->
  "7148e1ef-d46d-6846-99cf-b81c6f06050e"]
}], "Usage",
 CellID->433117385,ExpressionUUID->"f79a4d53-df9b-7c42-810d-ce83f1a024d7"],

Cell["\<\
Growth adds right-hand structure; constraining deletes a right-hand edge, \
reduces an arity or adds a left-hand condition so that growth eventually \
stops. In StructureAdaptiveEvolution the strategy option \"PhaseSchedule\" \
(\"Random\" or \"Sequential\") decides the phase.\
\>", "Notes",
 CellID->241086566,ExpressionUUID->"80c777ab-7972-cb48-ad84-c995130bf88d"],

Cell[TextData[{
 "Mutations are random. The result is a rule, an Association with the keys \
\"Rule\" and \"Details\", or a Failure when no valid, canonically different \
mutant exists. Within ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "4767646d-5d6f-1840-ba91-0fe9f6e11098"],
 " every operator that runs is recorded in the candidate's provenance."
}], "Notes",
 CellID->586519367,ExpressionUUID->"6ea1d364-21ac-1144-acc5-0e33921cf557"]
}, Open  ]],

