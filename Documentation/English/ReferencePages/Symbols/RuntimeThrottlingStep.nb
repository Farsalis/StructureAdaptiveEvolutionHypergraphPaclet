Notebook[{

Cell[CellGroupData[{
Cell["RuntimeThrottlingStep", "ObjectName",
 CellID->559006563,ExpressionUUID->"7f2e5f5f-4367-8a45-9730-18a6d02069ed"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ffb45a28-f787-5543-8694-00776478d1b6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RuntimeThrottlingStep",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
RuntimeThrottlingStep"], 
   RowBox[{"[", 
    RowBox[{
    "rule", ",", " ", "evolveFunction", ",", " ", "retainedStateFraction"}], 
    "]"}]}]], "InlineFormula",ExpressionUUID->
  "48e405d8-45a6-d14b-bfc2-d033ddfdb6c9"],
 " \[LineSeparator]",
 "applies \
[RuntimeThrottlingMutation](paclet:SamuelFrerichs/StructureAdaptiveEvolution/\
ref/RuntimeThrottlingMutation) to ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "26765298-f03f-c843-a31a-6c6b549eb431"],
 " and accepts the mutant when it runs faster without losing too much \
structure."
}], "Usage",
 CellID->168450004,ExpressionUUID->"c1599a02-2aa8-f54c-8341-abde3103ac3d"],

Cell[TextData[{
 StyleBox["evolveFunction",
  FontSlant->Italic],
 Cell[BoxData[
  TemplateBox[{
   "*r*] must give the generations of a multiway evolution of *r*. The mutant \
is accepted when its runtime decreases, its state count is at least \
*retainedStateFraction* (default 0.5) times the parent's, and it halts \
whenever the parent halts. Runtimes are wall-clock times, so acceptance can \
vary between runs.\n\nThis standalone hill-climbing step predates the central \
search; [StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "befc0fa7-c7bd-c544-8ceb-3efa5a65fbc7"],
 " uses the mutation operators directly and evaluates candidates with one \
shared evaluator. The step gives an Association with \"AcceptedQ\", \"Rule\" \
(the mutant if accepted, else the input), \"CandidateRule\", \"OldFitness\" \
and \"NewFitness\"."
}], "Notes",
 CellID->259867518,ExpressionUUID->"d968a8ee-a55a-5941-81ca-071e20e26875"]
}, Open  ]],

