Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"evolveGenerations", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CanonicalMultiwayEvolution", "[", 
      RowBox[{"#1", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "}"}], ",", 
       RowBox[{"Association", "[", 
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "3"}], "]"}]}], "]"}], 
     "[", "\"\<Generations\>\"", "]"}], "&"}]}], ";", 
  RowBox[{"Length", "/@", 
   RowBox[{"evolveGenerations", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->427421099,ExpressionUUID->"b3e7036d-cd8a-f34c-ae36-910f53e47c0b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->6539974,ExpressionUUID->"272f32fb-4e7b-3e41-a255-b1079a473094"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BlockRandom", "[", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "2", "]"}], ";", 
   RowBox[{"RuntimeThrottlingStep", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}], ",", 
     "evolveGenerations"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->447854662,ExpressionUUID->"bd52af93-478a-8049-9a4f-7ee5e1096375"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"AcceptedQ\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"Rule\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}]}], ",", 
   RowBox[{"\<\"CandidateRule\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}]}], ",", 
   RowBox[{"\<\"OldFitness\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"MultiwayStateCount\"\>", "\[Rule]", "38"}], ",", 
      RowBox[{"\<\"MultiwayLifetime\"\>", "\[Rule]", "3"}], ",", 
      RowBox[{"\<\"HGMaxVerticesCount\"\>", "\[Rule]", "9"}], ",", 
      RowBox[{"\<\"HGMaxEdgesCount\"\>", "\[Rule]", "8"}], ",", 
      RowBox[{"\<\"HaltedWithinCapQ\"\>", "\[Rule]", "False"}], ",", 
      RowBox[{"\<\"Runtime\"\>", "\[Rule]", "1.3711718`"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"NewFitness\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"MultiwayStateCount\"\>", "\[Rule]", "4"}], ",", 
      RowBox[{"\<\"MultiwayLifetime\"\>", "\[Rule]", "3"}], ",", 
      RowBox[{"\<\"HGMaxVerticesCount\"\>", "\[Rule]", "6"}], ",", 
      RowBox[{"\<\"HGMaxEdgesCount\"\>", "\[Rule]", "5"}], ",", 
      RowBox[{"\<\"HaltedWithinCapQ\"\>", "\[Rule]", "False"}], ",", 
      RowBox[{"\<\"Runtime\"\>", "\[Rule]", "0.2605855`"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->280293313,ExpressionUUID->"2165a84d-7bac-774e-8401-ac3daf22ee13"]
}, Open  ]]
