Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"comparison", "=", 
   RowBox[{"BaselineComparison", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<Rule\>\"", "\[Rule]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}], "}"}]}]}], ",", 
       RowBox[{"\"\<InitialState\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"\"\<Rounds\>\"", "\[Rule]", "1"}], ",", 
       RowBox[{"\"\<MutationBudget\>\"", "\[Rule]", "2"}], ",", 
       RowBox[{"\"\<EvolutionLimits\>\"", "\[Rule]", 
        RowBox[{"Association", "[", 
         RowBox[{
          RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "3"}], ",", 
          RowBox[{"\"\<MaxEvents\>\"", "\[Rule]", "200"}]}], "]"}]}], ",", 
       RowBox[{"\"\<InitialStateDiagnostics\>\"", "\[Rule]", "None"}]}], 
      "}"}], ",", 
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<Seeds\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}], ",", 
       RowBox[{"\"\<MaxExhaustiveRules\>\"", "\[Rule]", "20"}]}], "]"}]}], 
    "]"}]}], ";", 
  RowBox[{"Keys", "[", "comparison", "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->15840027,ExpressionUUID->"030a9ecf-3d46-5a4b-ba4d-6f2121e7c444"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Budget\"\>", ",", "\<\"Seeds\"\>", ",", "\<\"Signature\"\>", 
   ",", "\<\"InitialState\"\>", ",", "\<\"Rule\"\>", 
   ",", "\<\"StateEquivalence\"\>", ",", "\<\"EvolutionLimits\"\>", 
   ",", "\<\"Methods\"\>", ",", "\<\"Results\"\>"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->222751036,ExpressionUUID->"e6472324-28e3-1848-8134-b1b41a3b312b"]
}, Open  ]]
