      RowBox[{"{", 
       RowBox[{"3", ",", "2", ",", "1"}], "}"}]}], "}"}], 
    ",", "\"\<Declared\>\"", ",", 
    RowBox[{"Association", "[", 
     RowBox[{"3", "\[Rule]", "\"\<Cyclic\>\""}], "]"}]}], "]"}], "===", 
  RowBox[{"CanonicalStateForm", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3", ",", "1"}], "}"}]}], "}"}], 
    ",", "\"\<Declared\>\"", ",", 
    RowBox[{"Association", "[", 
     RowBox[{"3", "\[Rule]", "\"\<Cyclic\>\""}], "]"}]}], "]"}]}]], "Input",
