Cell[CellGroupData[{
Cell["RuntimeThrottlingMutation", "ObjectName",
 CellID->94445083,ExpressionUUID->"d61af1d9-1b0e-0d48-a7d7-bcd8523da232"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b0ddf2ca-c0f5-d94e-99b5-cceee305729b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RuntimeThrottlingMutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
RuntimeThrottlingMutation"], 
   RowBox[{"[", "rule", "]"}]}]], "InlineFormula",ExpressionUUID->
  "2aa28c51-cd26-9747-9bce-7f02078a5cf6"],
 " \[LineSeparator]",
 "reduces the right-hand structure of ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "6875789a-7615-0b4e-9258-0dcdb0e1dd0f"],
 " by deleting an edge or reducing an arity."
}], "Usage",
 CellID->37438271,ExpressionUUID->"c4a3d1d2-1e4c-4643-ba20-85c7231ba687"],

Cell["\<\
This is the operator of the RuntimeThrottling strategy (catalog 11): \
computationally manageable evolution.\
\>", "Notes",
 CellID->65473268,ExpressionUUID->"64706517-1df5-bd45-8686-cdeaedb22ab0"],

Cell[TextData[{
 "Mutations are random. The result is a rule, an Association with the keys \
\"Rule\" and \"Details\", or a Failure when no valid, canonically different \
mutant exists. Within ",
 Cell[BoxData[
  TemplateBox[{
   "StructureAdaptiveEvolution", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/StructureAdaptiveEvolution.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "49ce58f0-9e54-b746-8501-61a697305387"],
 " every operator that runs is recorded in the candidate's provenance."
}], "Notes",
 CellID->513715371,ExpressionUUID->"6d80425e-b37e-934c-9c4b-48f560abf77b"]
}, Open  ]],

