 Cell[BoxData[
  StyleBox["result", "TI"]], "InlineFormula",ExpressionUUID->
  "3f78d83a-49f4-1c48-bb75-c8176bdd9098"],
 " to the experiment store in the directory ",
 Cell[BoxData[
  StyleBox["storeDir", "TI"]], "InlineFormula",ExpressionUUID->
  "ba39cd91-5490-4b49-8797-eac1b54d6f8a"],
 "."
}], "Usage",
 CellID->3381054,ExpressionUUID->"75d36c89-20c9-8545-a246-ed5c62d88948"],

Cell[TextData[{
 "The run is exported to storeDir/runs/",
 StyleBox["RunID",
  FontSlant->Italic],
 "/ with ",
 Cell[BoxData[
  TemplateBox[{
   "ExportEvolutionResult", 
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
ExportEvolutionResult", 
    "https://reference.wolfram.com/language/SamuelFrerichs/\
StructureAdaptiveEvolution/ref/ExportEvolutionResult.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "1f772d9c-388d-c840-b736-e0178d5fcb9a"],
 ", and a run row plus one row per candidate (run ID, candidate ID, \
evaluation ID, evolution key, status, rule, fitness, front membership, ...) \
are appended to storeDir/index.wxf, which is written atomically. A run that \
is already stored gives a Failure unless \"Overwrite\" -> True."
}], "Notes",
 CellID->433638615,ExpressionUUID->"f65e0d1d-3343-ea49-877e-d992727e389a"]
}, Open  ]],

