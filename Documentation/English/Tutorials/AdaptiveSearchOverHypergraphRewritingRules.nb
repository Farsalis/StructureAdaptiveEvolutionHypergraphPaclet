Cell["Adaptive search over hypergraph rewriting rules", "Title",ExpressionUUID->"970cfa44-6953-854d-b46a-339fb2d4c61d"],

Cell["\<\
This tutorial walks through a complete use of the paclet: how states and \
rules are identified, how one rule is explored and what its status means, how \
an adaptive search proposes and selects rules, how to read and reproduce its \
results, and what the results do and do not claim.\
\>", "Text",ExpressionUUID->"a498965b-03b2-9144-b9a7-cdc1bb52891d"],

Cell[CellGroupData[{

Cell["Load the paclet and its visualizations:", "MathCaption",ExpressionUUID->"d5015196-db17-3f48-9dc3-b676d1489be5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "Needs", "[", \
"\"\<SamuelFrerichs`StructureAdaptiveEvolution`Visualizations`\>\"", "]"}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"5b2fefe3-b617-f24c-8a7b-350f00e33d8e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["States, rules and universes", "Section",ExpressionUUID->"5c345c36-a6af-8742-9e65-9955af22003a"],

Cell["\<\
A state is a list of hyperedges. Two states that differ only by renaming \
vertices or reordering edges are the same state: canonical forms identify \
them.\
\>", "Text",ExpressionUUID->"c91950c8-c347-024e-9fe9-1bee232d43ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CanonicalStateForm", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"7", ",", "9"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"9", ",", "4"}], "}"}]}], "}"}], "]"}], "===", 
  RowBox[{"CanonicalStateForm", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"6e1a7f4a-9fbd-ce4f-9a26-73ab37f5bf08"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]=",ExpressionUUID->"cff8a772-466b-c244-9b4f-2cec4a4b8259"]
}, Open  ]],

Cell["\<\
Whether the slots of a hyperedge are ordered is a choice of universe. In the \
default unordered universe the two orientations of an edge are one edge; in \
the ordered universe they differ:\
\>", "Text",ExpressionUUID->"017ca6ae-7995-6f44-8e09-c4271a6b89a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"CanonicalStateForm", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}], "}"}], ",", "\"\<Unordered\>\""}], 
    "]"}], ",", 
   RowBox[{"CanonicalStateForm", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}], "}"}], ",", "\"\<Ordered\>\""}], 
    "]"}]}], "}"}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"5b6fbf63-04a2-254d-a0aa-2e2420b01739"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]=",ExpressionUUID->"e2dd041c-6e5d-344c-a833-e0713196c665"]
}, Open  ]],

Cell["\<\
The declared universe gives every arity its own slot-symmetry group. Under \
cyclic symmetry an edge and its rotation are the same edge, while its \
reflection is not:\
\>", "Text",ExpressionUUID->"7a863726-cc42-b742-aaaa-e54cbddd0ed6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CanonicalStateForm", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "2", ",", "1"}], "}"}]}], "}"}], 
    ",", "\"\<Declared\>\"", ",", 
    RowBox[{"Association", "[", 
     RowBox[{"3", "\[Rule]", "\"\<Cyclic\>\""}], "]"}]}], "]"}], "===", 
  RowBox[{"CanonicalStateForm", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3", ",", "1"}], "}"}]}], "}"}], 
    ",", "\"\<Declared\>\"", ",", 
    RowBox[{"Association", "[", 
     RowBox[{"3", "\[Rule]", "\"\<Cyclic\>\""}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"59ca1c16-f848-3843-b773-db8a4bcf1cd3"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[4]=",ExpressionUUID->"c172ae7e-96c0-934b-8ffb-5d46f6f4b89e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Exploring one rule", "Section",ExpressionUUID->"06face30-85aa-d446-b775-3530887b9243"],

Cell["\<\
The rule {{1, 2}, {2, 3}} -> {{1, 3}} contracts a path of two edges into one. \
Starting from a path of four edges, every rewrite order eventually leaves a \
single edge:\
\>", "Text",ExpressionUUID->"d4515d09-f17c-ee4f-b8ef-20eb44cf90ca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"evolution", "=", 
   RowBox[{"CanonicalMultiwayEvolution", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "5"}], "}"}]}], "}"}], ",", 
     RowBox[{"Association", "[", "]"}]}], "]"}]}], ";", 
  RowBox[{"KeyTake", "[", 
   RowBox[{"evolution", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<Status\>\"", ",", "\"\<States\>\"", 
      ",", "\"\<TerminalStates\>\"", ",", "\"\<LongestDerivation\>\"", 
      ",", "\"\<EventCount\>\""}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"54bdbde7-6eac-024c-9432-f0b798e8eaae"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Status\"\>", "\[Rule]", "\<\"Halted\"\>"}], ",", 
   RowBox[{"\<\"States\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"TerminalStates\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "}"}]}], ",", 
   RowBox[{"\<\"LongestDerivation\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"EventCount\"\>", "\[Rule]", "12"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[5]=",ExpressionUUID->"cddffcd0-dd24-8241-a9b3-509be0271039"]
}, Open  ]],

Cell["\<\
\"Halted\" means the exploration exhausted every reachable state, up to \
isomorphism, and found no cycle: the system is verified to halt under this \
finite reachable exploration. Two other outcomes are possible. A cycle is an \
infinite derivation:\
\>", "Text",ExpressionUUID->"36e0defe-54d9-fe4e-8c42-91307fb8691d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CanonicalMultiwayEvolution", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], "}"}], ",", 
    RowBox[{"Association", "[", "]"}]}], "]"}], "[", "\"\<Status\>\"", 
  "]"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"b3eb4589-5801-444f-b77b-39d02d688e90"],

Cell[BoxData["\<\"CycleDetected\"\>"], "Output",
 CellLabel->"Out[6]=",ExpressionUUID->"72c0f7e9-019e-dd43-8c80-fed5217b0e0d"]
}, Open  ]],

Cell["\<\
A growing rule is stopped by a limit and is not resolved within the stated \
limits; its unexplored frontier is never reported as terminal:\
\>", "Text",ExpressionUUID->"bb957492-a77d-5c4f-bce1-9f8610114393"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KeyTake", "[", 
  RowBox[{
   RowBox[{"CanonicalMultiwayEvolution", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], ",", 
     RowBox[{"Association", "[", 
      RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "4"}], "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\"\<Status\>\"", ",", "\"\<LimitsReached\>\""}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"6948df22-b92e-2a45-a228-2d22f69fb81b"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Status\"\>", "\[Rule]", "\<\"GenerationCap\"\>"}], ",", 
   RowBox[{"\<\"LimitsReached\"\>", "\[Rule]", 
    RowBox[{"{", "\<\"MaxGenerations\"\>", "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[7]=",ExpressionUUID->"3fb52e92-5cd5-8148-96bf-02026c9c95bb"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["An adaptive search", "Section",ExpressionUUID->"e45b6003-396d-ac4e-8036-fdf6e2430c4a"],

Cell[TextData[{
 "Each round of ",
 Cell[BoxData[
  ButtonBox["StructureAdaptiveEvolution",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
StructureAdaptiveEvolution"]], "InlineFormula",ExpressionUUID->
  "b17596d8-bb78-f04e-874c-0ffed83a46a4"],
 " mutates rules from an archive of good candidates, choosing mutation \
strategies by adaptive weights, and evaluates every new candidate once. The \
search front ranks all valid candidates; the solution front keeps only \
candidates that halted and satisfy every constraint."
}], "Text",ExpressionUUID->"b955e43d-b142-1d41-80cd-c71f650ef8c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"StructureAdaptiveEvolution", "[", 
    RowBox[{
     RowBox[{"\"\<Rule\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], "}"}]}]}], ",", 
     RowBox[{"\"\<InitialState\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"\"\<Rounds\>\"", "\[Rule]", "2"}], ",", 
     RowBox[{"\"\<MutationBudget\>\"", "\[Rule]", "6"}], ",", 
     RowBox[{"\"\<EvolutionLimits\>\"", "\[Rule]", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "5"}], ",", 
        RowBox[{"\"\<MaxEvents\>\"", "\[Rule]", "400"}]}], "]"}]}], ",", 
     RowBox[{"\"\<InitialStateDiagnostics\>\"", "\[Rule]", "None"}], ",", 
     RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", "2026"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"e5f1e948-840a-c34a-a4e3-a2c4bce6e9e6"],

Cell[CellGroupData[{

Cell["Outcomes of all candidates:", "MathCaption",ExpressionUUID->"3f8a15ae-b484-de4b-95bd-e7517d7be7f5"],

Cell[BoxData[
 RowBox[{"Counts", "[", 
  RowBox[{"Lookup", "[", 
   RowBox[{
    RowBox[{"result", "[", "\"\<Candidates\>\"", "]"}], 
    ",", "\"\<Status\>\""}], "]"}], "]"}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"a01f786e-9dcb-8845-86b0-e51b23569095"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Halted\"\>", "\[Rule]", "8"}], ",", 
   RowBox[{"\<\"CycleDetected\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"EventCap\"\>", "\[Rule]", "2"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[9]=",ExpressionUUID->"9836915a-0f0f-a245-a5ff-114e222c89df"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rules on the solution front:", "MathCaption",ExpressionUUID->"f2d3c6d4-30d6-c94c-8e79-ff5588aab636"],

Cell[BoxData[
 RowBox[{"Lookup", "[", 
  RowBox[{
   RowBox[{"result", "[", "\"\<SolutionParetoFront\>\"", "]"}], 
   ",", "\"\<Rule\>\""}], "]"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"a47e04a5-87c2-9b45-a07b-0f1737582e38"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "4"}], "}"}]}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "5"}], "}"}]}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"4", ",", "5"}], "}"}], "}"}]}]}], "}"}]], "Output",
 CellLabel->"Out[10]=",ExpressionUUID->"3da31560-5807-8b4c-82c4-46f537d9eaf4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The provenance records what is needed to reproduce the run:", \
"MathCaption",ExpressionUUID->"c1846ec1-f4b8-2248-9a05-facf95df1b47"],

Cell[BoxData[
 RowBox[{"KeyTake", "[", 
  RowBox[{
   RowBox[{"result", "[", "\"\<Provenance\>\"", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\"\<PacletVersion\>\"", ",", "\"\<HypergraphPacletVersion\>\"", 
     ",", "\"\<EvaluatorVersion\>\"", ",", "\"\<RandomSeed\>\"", 
     ",", "\"\<StateEquivalence\>\"", ",", "\"\<RewriteSemantics\>\""}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"5947f9f5-79e0-8941-9566-ec23e1a37d7a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"PacletVersion\"\>", "\[Rule]", "\<\"2.0.0\"\>"}], ",", 
   RowBox[{"\<\"HypergraphPacletVersion\"\>", "\[Rule]", "\<\"1.2.3\"\>"}], ",", 
   RowBox[{"\<\"EvaluatorVersion\"\>", "\[Rule]", "\<\"2.0\"\>"}], ",", 
   RowBox[{"\<\"RandomSeed\"\>", "\[Rule]", "2026"}], ",", 
   RowBox[{"\<\"StateEquivalence\"\>", 
    "\[Rule]", "\<\"ExactCanonical-UnorderedSimple\"\>"}], ",", 
   RowBox[{"\<\"RewriteSemantics\"\>", "\[Rule]", "\<\"EdgeToken\"\>"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[11]=",ExpressionUUID->"5e208b3e-4668-b14e-be01-4368f468ad85"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Every candidate records the exact operators that produced it:\
\>", "MathCaption",ExpressionUUID->"e7b95b95-4c03-8a4a-a006-2372e995cb26"],

Cell[BoxData[
 RowBox[{"Lookup", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Lookup", "[", 
     RowBox[{
      RowBox[{"Last", "[", 
       RowBox[{"result", "[", "\"\<Candidates\>\"", "]"}], "]"}], 
      ",", "\"\<Provenance\>\""}], "]"}], "[", "\"\<AppliedOperators\>\"", 
    "]"}], ",", "\"\<Operator\>\""}], "]"}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"9535d722-b884-d94e-a50d-eccd882307ed"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"AddRHSVariable\"\>", ",", "\<\"AddRHSEdge\"\>"}], 
  "}"}]], "Output",
 CellLabel->"Out[12]=",ExpressionUUID->"4bfda560-024d-284f-9333-44713ca2e3e1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Reading the result", "Section",ExpressionUUID->"afeafc5f-247b-a441-8698-03674e34577b"],

Cell[TextData[{
 "The dashboard shows the run summary, the candidates, the fronts, the \
lineage and one candidate, all from stored data. ",
 Cell[BoxData[
  ButtonBox["EvolutionSummaryTable",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
EvolutionSummaryTable"]], "InlineFormula",ExpressionUUID->
  "bb94ed2e-b36a-2f49-8a66-4afc268ac633"],
 ", ",
 Cell[BoxData[
  ButtonBox["ParetoFrontPlot",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/ParetoFrontPlot"]], 
