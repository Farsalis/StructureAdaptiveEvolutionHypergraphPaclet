Cell[CellGroupData[{

Cell["Goals, strategies and metrics", "Section",ExpressionUUID->"c08ab81b-b1dd-6f43-98a5-3a1c94e978f4"],

Cell["\<\
The default goal looks for large systems that verifiably halt. The other goal \
presets each select one strategy of the mutation catalog and promote its \
primary objectives; diagnostics never become objectives silently.\
\>", "Text",ExpressionUUID->"dbe7f12d-3c47-0a49-bf07-845e7f2217f6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ValidateEvolutionConfiguration", "[", 
   RowBox[{"Association", "[", 
    RowBox[{"\"\<Goal\>\"", "\[Rule]", "\"\<HubPruning\>\""}], "]"}], "]"}], 
  "[", "\"\<MutationStrategies\>\"", "]"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"5e2225f1-096b-254a-a194-a556372a6295"],

Cell[BoxData[
 RowBox[{"{", "\<\"HubPruning\"\>", "}"}]], "Output",
 CellLabel->"Out[14]=",ExpressionUUID->"54923e8f-4f42-5b4f-9ca2-016b6a71bf20"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The metrics this preset promotes:", "MathCaption",ExpressionUUID->"f5245d9e-40e5-0243-ad7c-8952ed0a0adc"],

Cell[BoxData[
 RowBox[{"Keys", "[", 
  RowBox[{
   RowBox[{"ValidateEvolutionConfiguration", "[", 
    RowBox[{"Association", "[", 
     RowBox[{"\"\<Goal\>\"", "\[Rule]", "\"\<HubPruning\>\""}], "]"}], "]"}], 
   "[", "\"\<MetricOverrides\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"84a9f90f-5a67-924f-a6e9-200063adea6f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"MaxVertexDegree\"\>", ",", "\<\"VertexDegreeVariance\"\>"}], 
  "}"}]], "Output",
 CellLabel->"Out[15]=",ExpressionUUID->"74f9c6db-6fbe-6f4b-89e9-3fafe9697e79"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Reproducible experiments", "Section",ExpressionUUID->"519667d5-f23b-3249-b45f-5ade2132365e"],

Cell[TextData[{
 "Results export losslessly with a run manifest, and ",
 Cell[BoxData[
  ButtonBox["ImportEvolutionResult",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/\
ImportEvolutionResult"]], "InlineFormula",ExpressionUUID->
  "22a274aa-cd2e-004e-848a-d2240b130e3f"],
 " verifies the stored hash:"
}], "Text",ExpressionUUID->"59ddccdd-d6ed-9448-a7b7-d8df081ed2f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"directory", "=", 
   RowBox[{
    RowBox[{"ExportEvolutionResult", "[", 
     RowBox[{"result", ",", 
      RowBox[{"CreateDirectory", "[", "]"}]}], "]"}], "[", "\"\<Directory\>\"",
     "]"}]}], ";", 
  RowBox[{
   RowBox[{"ImportEvolutionResult", "[", "directory", "]"}], "===", 
   "result"}]}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"e5741f7b-6752-cd4e-a6dc-9327b05cd91d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[18]=",ExpressionUUID->"c1c2cc83-1058-e64e-8a6d-521a826c173d"]
}, Open  ]],

Cell[TextData[{
 "A single run proves little. ",
 Cell[BoxData[
  ButtonBox["ReplicateEvolution",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/ReplicateEvolution"]\
], "InlineFormula",ExpressionUUID->"6fbc6060-16a4-5c47-8cfe-e284fe29f629"],
 " repeats a search over random seeds and reports the fraction of runs that \
found a verified solution, with a Wilson interval; ",
 Cell[BoxData[
  ButtonBox["BaselineComparison",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/BaselineComparison"]\
], "InlineFormula",ExpressionUUID->"930739cb-97c4-7040-bcbf-e9b595f968b9"],
 " compares guided search with random mutation and exhaustive enumeration at \
the same evaluation budget."
}], "Text",ExpressionUUID->"b0a8c236-203e-a24b-a3eb-8e0433008c89"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ReplicateEvolution", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Rule\>\"", "\[Rule]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}], "}"}]}]}], ",", 
      RowBox[{"\"\<InitialState\>\"", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"\"\<Rounds\>\"", "\[Rule]", "1"}], ",", 
      RowBox[{"\"\<MutationBudget\>\"", "\[Rule]", "3"}], ",", 
      RowBox[{"\"\<EvolutionLimits\>\"", "\[Rule]", 
       RowBox[{"Association", "[", 
        RowBox[{"\"\<MaxGenerations\>\"", "\[Rule]", "4"}], "]"}]}], ",", 
      RowBox[{"\"\<InitialStateDiagnostics\>\"", "\[Rule]", "None"}]}], "}"}],
     ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}], 
  "[", "\"\<SuccessFraction\>\"", "]"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"655c3f61-de8b-634a-8d68-89395541531e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Fraction\"\>", "\[Rule]", "1.`"}], ",", 
   RowBox[{"\<\"Successes\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"Trials\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"WilsonInterval\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.43850296824495455`", ",", "1.`"}], "}"}]}], ",", 
   RowBox[{"\<\"ConfidenceLevel\"\>", "\[Rule]", "0.95`"}], ",", 
   RowBox[{"\<\"Definition\"\>", 
    "\[Rule]", "\<\"Runs with at least one verified solution (Halted, at \
least one transition, every constraint satisfied); failed runs count as runs \
without a solution.\"\>"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[19]=",ExpressionUUID->"d4d83441-9d8b-f44f-ad98-d96ba69be4f5"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["DiscoveryReport",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SamuelFrerichs/StructureAdaptiveEvolution/ref/DiscoveryReport"]], 
  "InlineFormula",ExpressionUUID->"4683fe7a-cbac-bc45-850a-dddd45e176b4"],
 " states the evidence for one candidate in a fixed template:"
}], "Text",ExpressionUUID->"b70413d6-6776-6a49-b57b-99f043c2034b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DiscoveryReport", "[", 
    RowBox[{"result", ",", 
     RowBox[{
      RowBox[{"result", "[", "\"\<SolutionParetoFront\>\"", "]"}], "\[LeftDoubleBracket]", 
      RowBox[{"1", ",", "\"\<CandidateID\>\""}], "\[RightDoubleBracket]"}]}], 
    "]"}], "[", "\"\<Status and cycle evidence\>\"", "]"}], 
  "[", "\"\<Summary\>\"", "]"}]], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"5c3b5a2e-9a7a-b942-a5c5-759376d25042"],

Cell[BoxData["\<\"Halted: verified to halt under this finite reachable \
exploration\"\>"], "Output",
 CellLabel->"Out[20]=",ExpressionUUID->"afaf3306-7652-8b4f-bcaa-7160df5c0f27"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["What the results claim", "Section",ExpressionUUID->"006d0ce3-e1b4-2b4a-b3cc-4a7d6e66d05e"],

Cell["\<\
\"Halted\" is a finite, exact statement about the explored system: every \
derivation from this initial state ends, within the reachable state space \
that was exhausted. Capped and timed-out explorations are not resolved within \
the stated limits, and nothing is said about them beyond that. A detected \
cycle comes with a witness. Counts are always relative to a named state \
equivalence, and no result is a statement about all initial states or about \
physics.\
\>", "Text",ExpressionUUID->"d893418a-cd9e-ba40-9d69-7e9b072ccdfb"],

Cell["\<\
For an abstract model of this explorer, these status claims have been \
machine-checked in Lean 4: with a complete canonical form a halted \
exploration bounds every derivation and gives the exact longest derivation, \
and both remain true when canonical forms are only isomorphic copies of their \
inputs. That this implementation follows the model is tested, not proved.\
\>", "Text",ExpressionUUID->"ad22e80a-7618-994f-b060-94ace0c447a5"]
}, Open  ]],

